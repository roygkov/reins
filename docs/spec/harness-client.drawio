<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. События"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 1. О чём клиент сообщает ядру" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Событие клиента" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что делает ядро" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="400" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Что будет без события" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="55" width="350" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Начало сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;готовит вход: состояние, дела, память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="400" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;агент начинает без контекста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="95" width="350" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Запрос человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="300" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;открывает свободную задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="151" width="400" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;задача откроется на первом действии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="151" width="350" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Перед действием&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="300" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;решает: разрешить, спросить, отложить, отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="207" width="400" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;барьеры не действуют&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="207" width="350" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;После действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="300" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;пишет ответ человека и сбой инструмента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="263" width="400" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;нет фактов для проверки и крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="263" width="350" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Запуск и отчёт подчинённого&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="300" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;связывает с задачей, проверяет отчёт; его вопросы закрывает клиент с номером исполнителя&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="319" width="400" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;подчинённые вне учёта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="319" width="350" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Конец хода&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="300" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;закрывает задачу, вопрос без ответа это «нет»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="375" width="400" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;свободная задача ждёт срока&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="375" width="350" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Перед сжатием контекста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="300" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;отмечает задачу сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="431" width="400" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;после сжатия агент не знает о задаче&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="431" width="350" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Конец сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="487" width="300" height="46" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;пишет передачу со счётчиками, закрывает задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="487" width="400" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;следующая сессия не знает о прошлой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="487" width="350" height="46" as="geometry"/></mxCell><mxCell id="c30" value="Событие «перед действием» единственное, без которого харнес не может быть барьером. Остальные события ухудшают работу постепенно.&lt;br&gt;Действие, которое началось после вопроса, это «да» человека, даже если оно упало. Прерванное действие не считается ни «да», ни «нет»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Решения"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 2. Что ядро возвращает клиенту" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Решение ядра" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="280" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что должен уметь клиент" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="55" width="400" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Если клиент не умеет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="55" width="370" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;выполнить действие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="95" width="400" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;не применимо&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="370" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Отказать с причиной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="159" width="280" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;не выполнять и показать причину агенту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="159" width="400" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;харнес не может быть барьером&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="159" width="370" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="223" width="280" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;показать вопрос с выбором и вернуть ответ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="223" width="400" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;вопрос идёт в очередь, человек отвечает командой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="223" width="370" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отложить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="287" width="280" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;не выполнять и сообщить, что действие в очереди&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="287" width="400" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;действие считается отказом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="287" width="370" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Добавить после действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="351" width="280" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;передать агенту строку харнеса: источник вывода, предложение договора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="351" width="400" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;агент не узнаёт источник вывода&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="351" width="370" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Вернуть отчёт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="280" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;без окна: не завершать ход, до двух раз; в окне: ответ на отчёт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="415" width="400" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;проверка только записывает итог&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="415" width="370" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Ядро всегда возвращает решение в одном формате. Перевод в форму конкретного клиента делает адаптер." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Уровни соответствия"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 3. Что работает при разных возможностях клиента" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Функция харнеса" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Полный клиент" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="250" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Без вопроса с выбором" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="55" width="250" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Без события «до»" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="55" width="250" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Барьеры на запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="250" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="95" width="250" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="95" width="250" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Одна кнопка для решения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="300" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="151" width="250" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;команда: вопрос в очереди&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="151" width="250" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="151" width="250" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Проверка готовности с возвратом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="300" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="207" width="250" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="207" width="250" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;только запись итога&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="207" width="250" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Журнал и метрики&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="300" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="263" width="250" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="263" width="250" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;частично&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="263" width="250" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Память без команд человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="300" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="319" width="250" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="319" width="250" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="319" width="250" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Сценарии по манифесту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="300" height="46" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="375" width="250" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="375" width="250" height="46" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;без конверта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="375" width="250" height="46" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Работа без окна&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="300" height="46" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;если клиент запускается командой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="431" width="250" height="46" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;то же&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="431" width="250" height="46" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;то же&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="431" width="250" height="46" as="geometry"/></mxCell><mxCell id="c35" value="Уровень клиента ядро считает при старте из того, что сообщил адаптер, и пишет в журнал. Потом уровень измеряется: действие без события «до» это факт журнала.&lt;br&gt;При уровне «без события до» человек получает прямое сообщение: барьеры не действуют. Харнес не делает вид, что защищает." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Адаптер"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 4. Адаптер клиента: перевод и защита от смены формы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Событие клиента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;в форме клиента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Кодек&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проверяет форму, переводит&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Единое событие&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;один формат для ядра&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Ядро&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Кодек&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;переводит обратно&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;b&gt;Ответ клиенту&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;в форме клиента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="965" y="100" width="160" height="64" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Что случилось" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="220" width="380" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Что делает адаптер" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="420" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Поле события изменило форму&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="260" width="380" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;пишет событие «форма изменилась», барьеры работают дальше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="260" width="420" height="52" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Сбой при решении о записи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="322" width="380" height="52" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;спрашивает человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="322" width="420" height="52" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Сбой при решении о чтении&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="384" width="380" height="52" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;разрешает и пишет сбой в журнал; адаптер не загрузился: спрашивает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="384" width="420" height="52" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Ядро не ответило вовремя&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="446" width="380" height="52" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;срок закрывает клиент: действие не проходит&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="446" width="420" height="52" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Каждое поле клиента, на которое опирается адаптер, проверяется при каждом событии. Смена формы видна сразу, а не через неделю.&lt;br&gt;Правило сбоя одно: сомнение о записи решает человек, сомнение о чтении не останавливает работу.&lt;br&gt;Новый клиент это новый кодек. Ядро и пакеты не меняются.&lt;br&gt;Вопрос ждёт ответа под идентификатором вызова, который дал клиент. Без него: под сессией, инструментом и входом.&lt;br&gt;Копия адаптера без ядра рядом берёт ядро из каталога, который назван в конфигурации ключом source." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="540" width="940" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Работа без окна"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 5. Требования к клиенту для работы без человека" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Требование" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Зачем" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Запуск одной командой с задачей на входе&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;расписание и события запускают сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Модель задаётся при запуске&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;инструменты задаёт команда runner: харнес их не передаёт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Настройки рабочей папки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;их читает или не читает команда runner: харнес это не проверяет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;События даёт клиент через хуки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ядро ведёт задачу и журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Нет вопросов человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;то, что требует вопроса, уходит в очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Задачу можно продолжить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ответ из очереди действует в новой сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Без окна нельзя спросить. Поэтому действие с решением «спросить» превращается в «отложить»: оно ждёт в очереди, а задача продолжает остальное или останавливается.&lt;br&gt;Команда запуска просит модель, а пакеты её не назвали: запуска нет.&lt;br&gt;Задачи расписания идут параллельно, каждая в своей рабочей копии репозитория; число задаёт конфигурация (без ключа одна). Задача с проверкой командой идёт в самой работе, по одной. Таймер системы даёт команда reins timer." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
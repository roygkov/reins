<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Состав"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 1. Что лежит в пакете каждого уровня" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Пакет организации&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="340" height="400" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Коннекторы к системам&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Маркеры рабочих сред&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="171" width="300" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Общие барьеры&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="237" width="300" height="52" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Общие сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="303" width="300" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Верхние пределы: модели, токены, сроки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="369" width="300" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Пакет проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="340" height="400" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Команда проверки проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Защищённые места и ветки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="171" width="300" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Сценарии проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="237" width="300" height="52" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Скрипты сбора и проверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="303" width="300" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Сроки памяти и крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="369" width="300" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Личный пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="340" height="400" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Правила работы и частые задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Разрешения в границах уровней выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="171" width="300" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Уровни моделей по умолчанию&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="237" width="300" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Язык и тон&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="303" width="300" height="52" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Сроки вето и личные сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="369" width="300" height="52" as="geometry"/></mxCell><mxCell id="c21" value="Пакет это набор текстовых файлов: настройки, манифесты и скрипты. Пакет организации общий для всех. Пакет проекта лежит вместе с проектом. Личный пакет лежит у человека.&lt;br&gt;Харнес работает и без пакетов: тогда действуют только запреты ядра и свободные задачи.&lt;br&gt;Состав каталога пакета: файл настроек pack.json, правила работы pack.md, манифесты и их тексты для модели в manifests, скрипты сбора в collect, скрипты проверки в check, тесты пакета в tests. Скрипт это обычный файл внутри пакета: ссылка наружу скриптом не считается.&lt;br&gt;Раздел targets файла настроек называет пороги мер харнеса: имя меры и наибольшее значение одного дня. Порог ничего не запрещает: по нему харнес говорит человеку, что мера не в порядке." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1090" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Наложение"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 2. Как настройки разных уровней складываются" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Вид настройки" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Правило слияния" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Кто задаёт" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Барьеры&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;берётся самое строгое&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="420" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ядро, организация, проект, человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="95" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Пределы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;берётся наименьший&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="157" width="420" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;организация, затем проект и человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="157" width="330" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Разрешения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="300" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;только внутри разрешённого уровнем выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="219" width="420" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;проект и человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="219" width="330" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;объединяются, имена не повторяются&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="281" width="420" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;все три уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="281" width="330" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;человек выбирает из разрешённых&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="343" width="420" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;организация ограничивает, человек выбирает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="343" width="330" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Сроки вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;не короче минимума уровня выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="405" width="420" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;организация задаёт минимум&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="405" width="330" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Язык и тон&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="467" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;последнее слово за человеком&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="467" width="420" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="467" width="330" height="50" as="geometry"/></mxCell><mxCell id="c27" value="Одно правило на всё: нижний уровень может сузить барьер, но не расширить. Настройки без барьера нижний уровень заменяет: язык и тон, имя модели уровня, уровень по умолчанию, числа крафта, пороги мер. Сроки хранения берутся наибольшие.&lt;br&gt;Итог слияния считается кодом при старте и пишется в журнал. Человек может посмотреть, какой уровень дал каждое значение.&lt;br&gt;Коннекторы, роли исполнителей и список известных сред задаёт организация. Нижний уровень может убрать коннектор или пометить ещё одну среду производственной.&lt;br&gt;Список, которого не дал ни один пакет, означает «ничего», а не «без проверки». Пакет с ошибкой не подключается целиком, а с ним и уровни ниже. Уровни выше продолжают работать. Пакет с ошибкой назван в начале сессии и в списке сценариев.&lt;br&gt;Манифесты проверяются по итогу слияния всех уровней: предел человека действует на сценарий проекта." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1090" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Границы"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 3. Чего пакет не может" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что пытается сделать пакет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что происходит" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Ослабить барьер уровня выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Пакет не подключается&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Изменить ядро или контракт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Невозможно: пакет это данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Положить секрет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Отказ при проверке пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Положить код вне скриптов сбора и проверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отказ при проверке пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Изменить журнал или его формат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Невозможно: журнал принадлежит ядру&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Разрешить агенту править пакеты без вопроса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Запрет: правка пакета это вопрос человеку на каждую правку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Пакеты правит человек. Крафт может предложить правку: она идёт в очередь. Правка, которая расширяет запись или ослабляет барьер, не применяется по сроку.&lt;br&gt;Имя модели в пакете это имя, а не флаг клиента: иначе пакет не подключается.&lt;br&gt;Скрипты пакета идут в песочнице, когда конфиг машины её включил (сейчас только macOS): без сети и без записи вне временных каталогов, пока пакет организации не назвал иное. Без ключа песочницы нет. Сроки очереди задаёт пакет, не длиннее сроков ядра." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Жизненный цикл"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 4. Жизненный цикл пакета" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Изменён&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;человек или принятое предложение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Проверен&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код: поля, перечни, границы&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Подключён&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;при следующем старте&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Действует&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог слияния в журнале&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Откат&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;к прошлой версии&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="снова подключается" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1023" y="210"/><mxPoint x="579" y="210"/></Array></mxGeometry></mxCell><mxCell id="c13" value="Пакет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Где лежит" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="380" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Кто меняет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="370" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Организации&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;общий источник для всех людей&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="380" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ответственные в организации&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="370" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="300" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;вместе с проектом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="362" width="380" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;команда проекта, через обычное ревью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="362" width="370" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Личный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="300" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;локально у человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="424" width="380" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;только сам человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="424" width="370" height="50" as="geometry"/></mxCell><mxCell id="c25" value="У пакета есть версия контракта. Пакет старой версии продолжает работать, пока ядро её поддерживает.&lt;br&gt;Изменение пакета во время задачи на неё не влияет: задача работает с тем слиянием, с которым началась." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1090" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. От пустого к настроенному"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 5. Что даёт каждый пакет поверх пустого харнеса" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что подключено" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="260" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что начинает работать" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="55" width="400" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Чего ещё нет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="55" width="390" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Только ядро и клиент&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="260" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;запреты ядра, журнал, свободные задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="400" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;сценарии, проверка готовности, память о проекте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="390" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Плюс пакет организации&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="169" width="260" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;коннекторы, барьеры рабочих сред, общие сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="169" width="400" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;проверка готовности для кода проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="169" width="390" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Плюс пакет проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="243" width="260" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;проверка готовности, защита мест проекта, сценарии проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="243" width="400" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;личные разрешения и привычки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="243" width="390" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Плюс личный пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="317" width="260" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;меньше вопросов, нужные модели, свой язык и тон&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="317" width="400" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;сценарии под личные частые задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="317" width="390" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Плюс первые манифесты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="391" width="260" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;частая работа идёт по сценарию с проверкой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="391" width="400" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;остальное добавляется по данным крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="391" width="390" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Каждая строка работает сама по себе. Харнес полезен на любом шаге, а не только после полной настройки." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
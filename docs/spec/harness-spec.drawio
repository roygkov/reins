<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Вся модель"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 2. Вся модель на одной странице" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Человек" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="40" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Расписание&lt;br&gt;или событие" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="40" height="80" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Клиент агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;окно, терминал, без окна&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="190" height="60" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Модели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;разных уровней&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="170" height="60" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Адаптер клиента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;события и решения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="190" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Ядро&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="210" y="270" width="560" height="340" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;задача, состояния, манифест&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="315" width="250" height="70" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;слои правил, конверт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="315" width="250" height="70" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;факты и метрики&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="410" width="250" height="70" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Крафт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;детекторы, предложения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="410" width="250" height="70" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Очередь решений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;отложенные действия&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="510" width="250" height="70" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Очередь предложений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;окно вето&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="250" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Пакеты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="310" height="215" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Организация&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="270" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Проект&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="144" width="270" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="198" width="270" height="44" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Коннекторы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;чтение и запись, только через гейт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="310" height="60" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Внешние системы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код и сборка, рабочие среды,&lt;br&gt;задачи и связь&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="310" height="70" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Проверки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PASS или FAIL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="545" width="310" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="210" y="660" width="560" height="120" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Записи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;источник истины&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="700" width="160" height="56" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Индекс&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;производный&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="700" width="160" height="56" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;Состояние&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;счётчики, сроки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="160" height="56" as="geometry"/></mxCell><mxCell id="c26" value="разговор" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="решение, сводка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="запуск" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.205;entryY=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="правила, манифесты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;entryX=0.8;entryY=0;" edge="1" parent="1" source="c15" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c8" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Синее это контракты: их заполняют пакеты.&lt;br&gt;Фиолетовое это ядро: оно одно для всех.&lt;br&gt;Серое заменяемо: клиент, модели, системы, пакеты." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="310" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Общие правила"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 4. Правила, которые действуют во всей модели" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Доверие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="535" height="310" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;«Готово» доказывается фактом, а не текстом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="495" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Отчёт исполнителя это заявление&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="167" width="495" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Нет ответа проверки значит «не готово»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="229" width="495" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Метка итога всегда показывается человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="291" width="495" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Барьеры&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="595" y="60" width="535" height="310" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Нижний уровень может только ужесточить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="105" width="495" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Запись наружу утверждает человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="167" width="495" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Агент не меняет правила, журнал, очереди и пакеты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="229" width="495" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Без события «до» харнес говорит, что барьеров нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="291" width="495" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Экономия и развитие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="535" height="310" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Что считается кодом, не идёт через модель&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="495" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Харнес не зависит от дисциплины человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="497" width="495" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Изменение без способа замера не принимается само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="559" width="495" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Неиспользуемое отключается&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="621" width="495" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Независимость&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="595" y="390" width="535" height="310" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Модель не знает организации, проекта, человека и клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="435" width="495" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Контракт требует свойства, а не технологию&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="497" width="495" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Новая точка расширения после второго случая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="559" width="495" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Экземпляр может поправить модель, но не наоборот&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="621" width="495" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Состояния задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 2. Контур: состояния задачи и переходы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Нет задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Подготовка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сбор и условие&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Исполнение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент действует&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Публикация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог принят, конверт действует&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="140" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;фактами&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Закрыта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;с меткой итога&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="140" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ожидает человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Закрыта без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c11" value="триггер" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="есть работа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="нечего делать" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отчёт подан" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="PASS, записей нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="PASS, есть записи в конверте" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="470"/><mxPoint x="800" y="470"/></Array></mxGeometry></mxCell><mxCell id="c17" value="конец публикации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="FAIL: вернуть отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="130"/><mxPoint x="570" y="130"/></Array></mxGeometry></mxCell><mxCell id="c19" value="гейт спросил, решение принято" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="FAIL сверх предела возвратов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="445"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Правила контура&lt;/b&gt;&lt;br&gt;1. Состояние хранит харнес. Агент не может сам перевести задачу в «Закрыта».&lt;br&gt;2. Каждый переход пишется в журнал. Исключение: вход в публикацию своей строки не имеет.&lt;br&gt;3. Предел возвратов задаёт манифест: от 0 до 5. После предела решает человек.&lt;br&gt;4. Свободная задача идёт без манифеста: шаг «Проверка» пропускается, итог помечается «не проверено».&lt;br&gt;5. Сбой самого харнеса не блокирует работу: задача продолжается, сбой пишется в журнал.&lt;br&gt;6. У задачи может быть несколько исполнителей. Предел исполнителей и токенов задаёт пакет. Задача сверх предела токенов ждёт человека. Подробности на странице 4.&lt;br&gt;7. Задача с договором проходит те же состояния. Перед «Подготовкой» человек утверждает договор. Подробности на странице 5.&lt;br&gt;8. У события есть источник. Агент сообщает «готово» и вопрос. Ответ проверки даёт только харнес. Утверждение даёт только человек.&lt;br&gt;9. Состояние задачи это один файл вне рабочего дерева. Запись в него идёт по одному: два процесса не меняют одну задачу сразу.&lt;br&gt;10. Сбой сбора закрывает задачу с меткой «не проверено». Предел времени и размера действует и на процессы, которые запустил скрипт.&lt;br&gt;11. Принятый результат задачи с записями в конверте переводит задачу в публикацию: метка итога уже известна, конверт ещё действует.&lt;br&gt;12. Публикацию завершает агент, человек, срок или изменение работы. После этого конверт закрыт и задача закрыта." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1050" height="262" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Вид задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 6. Как запрос становится видом задачи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что пришло" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Как узнаётся" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="340" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Вид задачи" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="55" width="190" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Кто решает" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="55" width="170" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Расписание или событие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;привязка в манифесте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="340" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="95" width="190" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="95" width="170" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Команда с именем сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="147" width="330" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;имя сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="147" width="340" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="147" width="190" height="44" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="147" width="170" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Вход известной формы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="199" width="330" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;форма совпала с одним манифестом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="199" width="340" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="199" width="190" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;код, с отменой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="199" width="170" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Вход подходит нескольким сценариям&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="251" width="330" height="44" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;совпало больше одного манифеста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="251" width="340" height="44" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;по выбору&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="251" width="190" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="251" width="170" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Команда «задача» или кнопка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="303" width="330" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;явное слово человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="303" width="340" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;договор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="303" width="190" height="44" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="303" width="170" height="44" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Запрос человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="330" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;событие клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="355" width="340" height="44" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;свободная задача&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="355" width="190" height="44" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="355" width="170" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Действие без запроса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="407" width="330" height="44" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;факт действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="407" width="340" height="44" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;свободная задача&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="407" width="190" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="407" width="170" height="44" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;Разговор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;действий нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;Свободная задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b&gt;Предложение договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;работа не останавливается&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b&gt;Договор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;дальше как сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c39" value="запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="порог" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="кнопка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Правила выбора&lt;/b&gt;&lt;br&gt;1. Вид задачи определяют имя, форма входа и факты. Слова запроса вид не определяют.&lt;br&gt;2. Модель может подсказать человеку подходящий сценарий. Запустить сценарий по догадке она не может.&lt;br&gt;3. Ошибка в сторону свободной задачи видна: итог помечен «не проверено». Ошибка в сторону сценария дорога. Поэтому сценарий требует имени или формы входа.&lt;br&gt;4. Свободная задача растёт по фактам: порог действий записи задаёт пакет. Договор предлагается, но не навязывается.&lt;br&gt;5. Выбранный вид и причина выбора пишутся в журнал." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Границы задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 7. Где задача начинается и где кончается" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что произошло" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что происходит с задачей" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Проверка дала PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;нет записей в конверте: закрыта. Есть: публикация, конверт действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Новый сценарий в той же сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;старая задача приостановлена, её конверт молчит до возврата&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Действие вне конверта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;обычное решение политики, конверт не расширяется&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Нет действий дольше срока&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;задача закрыта как незавершённая, итог «не проверено»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Сессия закончилась&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;состояние задачи записано, её можно продолжить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Человек отклонил договор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;работа остаётся свободной задачей&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Конверт живёт не дольше задачи. Разрешение, выданное для одного сценария, не переходит на то, что человек попросил следом.&lt;br&gt;В одной сессии может быть много задач. У одной задачи может быть много сессий. Задачу ведёт харнес, а не сессия клиента.&lt;br&gt;Каждый запрос человека открывает свободную задачу. Она закрывается, когда агент остановился." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Задача с договором"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 5. Задача с договором: «вот задача, сделай»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;текст или ссылка от человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Предложение договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент, только чтение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Проверка договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код, как у манифеста&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Утверждение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;человек, одна кнопка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Разовый манифест&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;живёт одну задачу&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;b&gt;Работа сама&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;без окна, возвраты по проверке&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Упёрлась?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="262" y="200" width="190" height="84" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Итог с меткой&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;человеку&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;журнал и память&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Повтор договоров&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;крафт предлагает сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Вопрос или очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="320" width="190" height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1023" y="172"/><mxPoint x="135" y="172"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="ответ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="345"/></Array></mxGeometry></mxCell><mxCell id="c25" value='&lt;b&gt;Что входит в договор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;цель одной фразой&lt;br&gt;границы: что трогать и что нет&lt;br&gt;проверка готовности: вид и команда&lt;br&gt;нужные действия записи&lt;br&gt;пределы: токены, возвраты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Три вида задач&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сценарий: постоянный манифест из пакета&lt;br&gt;задача с договором: разовый манифест&lt;br&gt;свободная задача: без манифеста,&lt;br&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;Когда договор не помогает&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;у задачи нет проверяемого итога&lt;br&gt;тогда договор честно ставит метку&lt;br&gt;«не проверено»&lt;br&gt;работа идёт сама, но итогу верить нельзя&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;1. Договор предлагает агент, утверждает человек. Без утверждения работа не начинается.&lt;br&gt;2. Договор проверяется тем же кодом, что манифест. Он не может просить больше, чем разрешают пакеты.&lt;br&gt;3. После утверждения договор не меняется. Если задаче нужно больше, она останавливается: человек даёт идти дальше или завершает её.&lt;br&gt;4. Предел токенов обязателен. Договор без него не принимается.&lt;br&gt;5. Запись наружу остаётся за человеком: по конверту с одним утверждением или через очередь." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Решение политики"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 3. Политика: как принимается решение по одному действию" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Действие агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;команда или вызов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="160" height="60" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Разбор кодом&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид, цель, среда&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="230" width="180" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Слои правил&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="240" height="340" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Ядро&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запреты без исключений&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="200" height="56" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Организация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;рабочие среды, общие барьеры&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="202" width="200" height="56" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Проект&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;защищённые пути и ветки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="274" width="200" height="56" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Человек&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;личные разрешения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="346" width="200" height="56" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Свод решений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;берётся самое строгое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Конверт задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;из манифеста&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="170" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="160" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Отложить в очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="270" width="160" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="350" width="160" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="снимает вопрос&lt;br&gt;в своих границах" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Правила политики&lt;/b&gt;&lt;br&gt;1. Слой может только ужесточить решение слоя выше. Строгость растёт так: разрешить, спросить, отложить, отказать.&lt;br&gt;2. Конверт задачи заменяет «спросить» на «разрешить» только для действий, названных в манифесте, сразу или после одного утверждения на задачу. Запрет слоя он не снимает.&lt;br&gt;3. Решение и его основание пишутся в журнал. Текст команды в журнал не пишется, если в нём может быть секрет.&lt;br&gt;4. Запись агента в состояние, память и конфигурацию харнеса это отказ. Правка пакета, кода харнеса и настроек клиента это вопрос человеку.&lt;br&gt;5. Отложенное действие утверждает только человек. Перед командой утверждения клиент спрашивает человека.&lt;br&gt;6. Если клиент не сообщает о действии до его выполнения, харнес прямо говорит человеку, что барьеры не действуют.&lt;br&gt;7. Права подчинённого исполнителя не шире прав родителя. Он действует в конверте задачи родителя, своего конверта у него нет.&lt;br&gt;8. Решение по умолчанию это решение слоя ядра: чтение и изменение в рабочем дереве разрешены, запись требует вопроса. Нижний слой его не ослабляет.&lt;br&gt;9. Запись в производственную или неизвестную среду утверждает человек на каждое действие. Конверт на неё не действует.&lt;br&gt;10. Исход слоя вне перечня считается отказом." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1100" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. Несколько исполнителей"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 4. Несколько исполнителей в одной задаче" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;конверт задачи,&lt;br&gt;предел исполнителей и токенов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="340" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Основной исполнитель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ведёт задачу, раздаёт поручения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="280" height="60" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Читающий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;только чтение&lt;br&gt;возвращает вывод, а не содержимое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Проверяющий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;только чтение&lt;br&gt;не видит рассуждений автора&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Исполняющий часть&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запись в своей области&lt;br&gt;области не пересекаются&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Проверка отчёта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;кодом или независимым исполнителем&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="280" height="60" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;у строки есть&lt;br&gt;родительская задача&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="570" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="подтверждённый вывод" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="550"/><mxPoint x="1100" y="550"/><mxPoint x="1100" y="220"/></Array></mxGeometry></mxCell><mxCell id="c18" value="каждый шаг" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="528" y="620"/></Array></mxGeometry></mxCell><mxCell id="c19" value="Оправдано, когда нужна независимость, изоляция чтения или разные права.&lt;br&gt;Не оправдано для последовательной работы с записью и для малых задач." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="330" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;1. Права подчинённого не шире прав родителя.&lt;br&gt;2. Отчёт подчинённого это заявление, а не факт.&lt;br&gt;3. У каждой строки журнала есть родительская задача.&lt;br&gt;4. Предел исполнителей и токенов на задачу задаёт пакет.&lt;br&gt;5. Исполнители общаются только через основного.&lt;br&gt;6. Сбор данных делает скрипт, а не исполнитель." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="440" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9. Описание действия"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 1. Что коннектор сообщает о каждом своём действии" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Имя&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;по нему действие узнаётся&lt;br&gt;одно имя: запись или чтение по шаблону&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Вид&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;чтение или запись&lt;br&gt;изменение в дереве: только у клиента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Цель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;на что действует&lt;br&gt;шаблон с параметрами задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Среда&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;рабочая, проверочная, локальная&lt;br&gt;определяется по маркеру из пакета&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Обратимость&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;можно ли отменить&lt;br&gt;необратимое всегда решает человек&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Наружу&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;видит ли результат другой человек&lt;br&gt;сообщение, комментарий, публикация&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Чувствительность&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;секреты и личные данные&lt;br&gt;даже при чтении&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Предел вывода&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сколько возвращать агенту&lt;br&gt;остальное обрезается&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Как коннектор устроен внутри, ядру неважно: это может быть инструмент клиента, команда или скрипт. Важно только описание действий.&lt;br&gt;Описание лежит в пакете организации. Свои инструменты клиента описывает адаптер. По нему политика принимает решение, не понимая смысла действия.&lt;br&gt;Вызов инструмента без описания считается записью неизвестного вида.&lt;br&gt;Изменение в рабочем дереве разрешено по умолчанию: его покрывает отпечаток состояния работы." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1090" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="10. Среды"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 3. Решение по умолчанию: вид действия и среда" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Действие" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Среда" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Решение по умолчанию" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="55" width="390" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Чтение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;локальная или проверочная&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="390" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Чтение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;рабочая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;разрешить, факт в журнале&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="151" width="390" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Чтение чувствительного&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="207" width="390" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Запись обратимая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;локальная или проверочная&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;спросить, конверт может разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="263" width="390" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Запись наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;одно утверждение на задачу по конверту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="319" width="390" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;рабочая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;человек на каждое действие, конверт не действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="375" width="390" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Запись необратимая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек на каждое действие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="431" width="390" height="46" as="geometry"/></mxCell><mxCell id="c27" value="Среда определяется по маркеру: имя соединения, адрес или параметр. Маркеры задаёт пакет организации.&lt;br&gt;Если среду определить нельзя, она считается рабочей.&lt;br&gt;Пакет может сделать любое из этих решений строже. Мягче сделать нельзя." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11. Структура"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Манифест · 1. Структура: заголовок и восемь полей" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Заголовок&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;имя и название сценария · версия контракта · версия сценария · пакет-владелец: организация, проект или человек · состояние: работает или отключён · описание в одну строку&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;1. Триггер&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид: команда, расписание, событие&lt;br&gt;значение: расписание (every, daily, weekdays, weekly) или имя события&lt;br&gt;входные параметры: имя и тип&lt;br&gt;форма входа: по ней сценарий узнаётся без слов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="265" height="160" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;2. Сбор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;скрипт из пакета, работает без модели&lt;br&gt;только коннекторы чтения&lt;br&gt;именованные результаты и предел размера&lt;br&gt;признаки для условия запуска&lt;br&gt;предел времени&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="160" width="265" height="160" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;3. Условие запуска&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;имя признака из списка сбора&lt;br&gt;признак ложен: задача закрывается&lt;br&gt;без модели, причина идёт в журнал&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="160" width="265" height="160" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;4. Модель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;уровень: слабая, средняя, сильная; без него уровень даёт пакет&lt;br&gt;до какого уровня можно поднять&lt;br&gt;подчинённые исполнители: роли и число&lt;br&gt;предел токенов на задачу&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="160" width="265" height="160" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;5. Разрешения&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;чтение: перечень коннекторов&lt;br&gt;запись: действие, цель, среда&lt;br&gt;утверждение: не нужно или один раз на задачу&lt;br&gt;предел числа действий записи&lt;br&gt;действует при исполнении и публикации&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="265" height="160" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;6. Проверка готовности&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид: команда, артефакт, внешнее&lt;br&gt;состояние, сверка цитат, человек&lt;br&gt;предел возвратов: от 0 до 5&lt;br&gt;источник и изменённые файлы: результаты сбора&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="340" width="265" height="160" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;7. Форма результата&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид: список, таблица, текст, файл&lt;br&gt;обязательные разделы&lt;br&gt;предел размера&lt;br&gt;куда отдать: человеку или в систему&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="340" width="265" height="160" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;8. Запись в память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;какие типы записей разрешены&lt;br&gt;класс: само или с окном вето&lt;br&gt;по умолчанию ничего не пишется&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="340" width="265" height="160" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Правила формата&lt;/b&gt;&lt;br&gt;1. Поля фиксированы. Манифест с неизвестным полем не подключается.&lt;br&gt;2. В манифесте нет условий, ветвлений и исполняемого кода. Условие запуска это имя признака, а не выражение.&lt;br&gt;3. Значения берутся из закрытых перечней или ссылаются на объекты пакета: скрипт, коннектор, проверку.&lt;br&gt;4. Манифест может запросить меньше, чем разрешает пакет, но не больше.&lt;br&gt;5. Файл манифеста это JSON. Комментариев и вычисляемых значений в нём нет." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1090" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="12. Конверт разрешений"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Манифест · 3. Поле «Разрешения»: конверт задачи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Что можно назвать в конверте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="350" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Чтение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;перечень коннекторов чтения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="360" height="50" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;действие, цель по шаблону, среда&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="50" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Утверждение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;не нужно или один раз на задачу&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="360" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Предел&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;число действий записи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="360" height="50" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Срок&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;исполнение и публикация, публикация до часа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="360" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Чего в конверте быть не может&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="400" height="230" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Действие, которое слой правил запрещает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="360" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Изменение правил, журнала или очереди&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="360" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Цель «всё» без шаблона&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="360" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Итог политики с конвертом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="650" height="460" as="geometry"/></mxCell><mxCell id="c14" value="Решение слоёв" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="95" width="190" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Действие названо в конверте" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="220" height="30" as="geometry"/></mxCell><mxCell id="c16" value="Итог" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="95" width="180" height="30" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="135" width="190" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;не важно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="135" width="220" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="135" width="180" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;спросить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="197" width="190" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;да&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="197" width="220" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="197" width="180" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;спросить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="259" width="190" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;да, с утверждением&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="259" width="220" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;один вопрос на задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="259" width="180" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;спросить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="321" width="190" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="321" width="220" height="50" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="321" width="180" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;отложить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="383" width="190" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;не важно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="383" width="220" height="50" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;отложить в очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="383" width="180" height="50" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="445" width="190" height="50" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;не важно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="445" width="220" height="50" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="445" width="180" height="50" as="geometry"/></mxCell><mxCell id="c35" value="Конверт делает одно: заменяет «спросить» на «разрешить» для названных действий, сразу или после одного утверждения на задачу. Он не снимает отказ и не обходит очередь.&lt;br&gt;Манифест с недопустимым конвертом не подключается: это проверяет код при подключении, а не при работе.&lt;br&gt;Подчинённый исполнитель действует в конверте задачи родителя, своего у него нет.&lt;br&gt;Запись всегда называет среду. Пакет без списка сред не допускает записи в конверте: неизвестная среда считается производственной." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="545" width="650" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13. Виды проверок"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 2. Пять видов проверок в деталях" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Вид" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="170" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что запускается" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="55" width="250" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Что считается PASS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="55" width="240" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Свидетельство" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="55" width="200" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Метка итога" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="55" width="190" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Команда&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="170" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;скрипт пакета check/&lt;имя&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="250" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="240" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="95" width="200" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="95" width="190" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Артефакт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="163" width="170" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;скрипт пакета: поиск объекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="163" width="250" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="163" width="240" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="163" width="200" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="163" width="190" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Внешнее состояние&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="231" width="170" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;скрипт пакета: чтение через коннектор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="231" width="250" height="56" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="231" width="240" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="231" width="200" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="231" width="190" height="56" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Сверка цитат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="299" width="170" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;сравнение ссылок с источником&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="299" width="250" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;все ссылки найдены&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="299" width="240" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;список сверенного&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="299" width="200" height="56" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;проверена форма&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="299" width="190" height="56" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="170" height="56" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;вопрос с выбором&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="367" width="250" height="56" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;ответ «да»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="367" width="240" height="56" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;кто и когда ответил&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="367" width="200" height="56" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;утверждено человеком&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="367" width="190" height="56" as="geometry"/></mxCell><mxCell id="c33" value="Проверка может состоять из нескольких частей. Итог PASS только если все части дали PASS. При FAIL в ответе названа каждая часть, которая не прошла.&lt;br&gt;Новый вид проверки это изменение контракта. Новая команда проверки это изменение пакета проекта.&lt;br&gt;Вид «Человек» нужен там, где итог нельзя проверить кодом. Он честнее, чем слабая автоматическая проверка." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14. Привязка к состоянию"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 3. Привязка ответа к состоянию работы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Работа сделана&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент сказал «готово»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Отпечаток&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;снимает ядро&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;на этом состоянии&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Ответ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;хранит отпечаток&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Отпечаток&lt;br&gt;тот же?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="928" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Задача закрыта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="230" width="190" height="56" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Ответ недействителен&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="230" width="180" height="56" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value='&lt;b&gt;Что входит в отпечаток&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;изменённые места работы&lt;br&gt;цель записи для внешнего состояния&lt;br&gt;версия самой проверки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Когда ответ недействителен&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;работа изменилась после проверки&lt;br&gt;проверка изменилась после ответа&lt;br&gt;прошёл срок годности ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Выдержка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;внешнее состояние меняется со временем&lt;br&gt;проверка повторяется через срок&lt;br&gt;PASS засчитан после второго ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c19" value="Без привязки зелёный ответ можно получить на одном состоянии и закрыть задачу на другом. Привязка делает такой обход невозможным.&lt;br&gt;Выдержка нужна для операций: «алерты не горят» сразу после выкладки ещё ничего не значит. Срок выдержки задаёт манифест." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="15. Строка журнала"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 1. Строка журнала: общие поля каждого события" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Когда и что&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;время&lt;br&gt;версия схемы&lt;br&gt;вид события&lt;br&gt;источник: задача, политика, проверка,&lt;br&gt;исполнитель, память, крафт, харнес&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;К чему относится&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;задача&lt;br&gt;родительская задача&lt;br&gt;сессия&lt;br&gt;сценарий и его версия&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Кто&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;исполнитель: основной или подчинённый&lt;br&gt;роль исполнителя&lt;br&gt;уровень модели&lt;br&gt;клиент агента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Где&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проект&lt;br&gt;отпечаток состояния работы&lt;br&gt;пакет, из которого взято правило&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="350" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Данные события&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;поля зависят от вида события&lt;br&gt;только перечни, числа и отпечатки&lt;br&gt;строка это метка без пробелов&lt;br&gt;имя поля это идентификатор&lt;br&gt;свободного текста модели и человека нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="240" width="350" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Правила строки&lt;/b&gt;&lt;br&gt;1. Одна строка это одно событие. Строки только добавляются, прошлое не правится.&lt;br&gt;2. У строки есть версия схемы. Читатель пропускает поля, которых не знает.&lt;br&gt;3. Смысл поля не меняется. Новый смысл это новый вид события, а не новое значение старого поля.&lt;br&gt;4. Пишет только ядро. Агент не пишет в журнал и не меняет его.&lt;br&gt;5. Журнал хранит факты для кода. Тексты запросов, команд и отчётов в него не попадают: только вид, размер и отпечаток." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="16. Виды событий"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 2. Виды событий по источникам" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;задача открыта&lt;br&gt;вид задачи определён, с причиной&lt;br&gt;договор предложен&lt;br&gt;договор утверждён&lt;br&gt;подготовка завершена&lt;br&gt;задача пропущена: работы нет&lt;br&gt;исполнение начато&lt;br&gt;отчёт подан&lt;br&gt;задача возвращена&lt;br&gt;ожидание человека&lt;br&gt;решение человека, в том числе «нет»&lt;br&gt;задача закрыта: метка итога, была ли правка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение по действию&lt;br&gt;основание решения: слой и правило&lt;br&gt;конверт открыт&lt;br&gt;конверт закрыт&lt;br&gt;действие отложено&lt;br&gt;отложенное действие решено&lt;br&gt;попытка изменить защищённое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проверка запущена&lt;br&gt;ответ проверки: PASS или FAIL&lt;br&gt;проверка не ответила&lt;br&gt;ответ недействителен: работа изменилась&lt;br&gt;превышен предел возвратов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Исполнители и стоимость&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;исполнитель запущен&lt;br&gt;отчёт исполнителя получен&lt;br&gt;отчёт подтверждён или отклонён&lt;br&gt;уровень модели поднят&lt;br&gt;расход: токены, время, вызовы&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Память и крафт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;память прочитана&lt;br&gt;запись использована&lt;br&gt;запись добавлена, изменена или удалена&lt;br&gt;паттерн найден&lt;br&gt;предложение создано&lt;br&gt;предложение применено или отклонено&lt;br&gt;замер эффекта&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Харнес&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сбой харнеса&lt;br&gt;превышено время шага&lt;br&gt;форма события клиента изменилась&lt;br&gt;уровень клиента определён&lt;br&gt;барьеры не действуют&lt;br&gt;итог слияния пакетов&lt;br&gt;пакет изменён&lt;br&gt;манифест отклонён при подключении&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c9" value="Перечень видов закрыт: событие неизвестного вида в журнал не пишется. Новый вид добавляется вместе с новой версией схемы.&lt;br&gt;Группа «Харнес» это журнал о самом харнесе: по ней видно, можно ли доверять остальным строкам.&lt;br&gt;Источников семь: задача (группа «Контур»), политика, проверка, исполнитель, память, крафт, харнес. Источник это начало имени вида события." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1090" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p17" name="17. Типы записей"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 2. Типы записей и общие поля" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Решение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что решено&lt;br&gt;почему&lt;br&gt;что отвергнуто&lt;br&gt;когда пересмотреть&lt;br&gt;какую запись заменяет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ловушка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;неочевидный факт о системе&lt;br&gt;вид: событие или состояние&lt;br&gt;привязка к месту в работе&lt;br&gt;дата последней проверки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Дело&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что не закончено&lt;br&gt;следующий шаг&lt;br&gt;внешний статус, если он есть&lt;br&gt;сколько дней перенесено&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Состояние&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;где мы сейчас&lt;br&gt;что делать дальше&lt;br&gt;что не проверено&lt;br&gt;переписывается целиком&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Общие поля каждой записи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;идентификатор · тип · дата · источник: задача и сессия · привязка: место в работе и его отпечаток&lt;br&gt;статус: черновик, действует, устарела, заменена, удалена, закрыта · область: проект или все проекты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1090" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Правила записей&lt;/b&gt;&lt;br&gt;1. Решение без причины не принимается: через месяц оно бесполезно.&lt;br&gt;2. В память не пишут то, что видно из самой работы или её истории изменений.&lt;br&gt;3. Предпочтения человека, например язык и тон, это личный пакет, а не память.&lt;br&gt;4. Запись становится общей по слову человека: команда share." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1090" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p18" name="18. Жизненный цикл"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 3. Жизненный цикл записи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Наблюдение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Кандидат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Устарела&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Удалена&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вето человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Заменена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Закрыта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;дело закончено&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c10" value="порог" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="срок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="нет ссылок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="вето" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="222"/><mxPoint x="460" y="112"/></Array></mxGeometry></mxCell><mxCell id="c14" value="вето" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="новая о том же" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.4;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="конец дела" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="150"/><mxPoint x="805" y="150"/></Array></mxGeometry></mxCell><mxCell id="c17" value="подтверждена" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="175"/><mxPoint x="627" y="175"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Повтор в журнале или слово человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Ждёт в очереди. Вето одной кнопкой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Попадает во вход задач. Ссылки считаются&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Нет ссылок за срок или место в работе изменилось&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c22" value="Переходы делает код. Человек нужен в трёх местах: вето на запись, решение с причиной, возврат удалённой или устаревшей записи.&lt;br&gt;Привязка к месту в работе хранит отпечаток. Если место изменилось, запись уходит в «Устарела», а не продолжает влиять на ответы.&lt;br&gt;Удаление это вето человека: смена статуса из любого состояния, кроме «Заменена» и «Закрыта». Содержимое остаётся, человек может вернуть запись в «Действует».&lt;br&gt;Новое состояние действует сразу и заменяет прежнее: окна вето у него нет. Дело получает шаг и конец командой: закрытое дело уходит в «Закрыта»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p19" name="19. Наложение"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Пакеты · 2. Как настройки разных уровней складываются" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Вид настройки" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Правило слияния" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Кто задаёт" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Барьеры&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;берётся самое строгое&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="420" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ядро, организация, проект, человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="95" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Пределы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;берётся наименьший&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="157" width="420" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;организация, затем проект и человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="157" width="330" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Разрешения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="300" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;только внутри разрешённого уровнем выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="219" width="420" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;проект и человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="219" width="330" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;объединяются, имена не повторяются&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="281" width="420" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;все три уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="281" width="330" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;человек выбирает из разрешённых&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="343" width="420" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;организация ограничивает, человек выбирает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="343" width="330" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Сроки вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;не короче минимума уровня выше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="405" width="420" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;организация задаёт минимум&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="405" width="330" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Язык и тон&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="467" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;последнее слово за человеком&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="467" width="420" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="467" width="330" height="50" as="geometry"/></mxCell><mxCell id="c27" value="Одно правило на всё: нижний уровень может сузить, но не расширить. Исключение одно: язык и тон, потому что они ничего не разрешают.&lt;br&gt;Итог слияния считается кодом при старте и пишется в журнал. Человек может посмотреть, какой уровень дал каждое значение.&lt;br&gt;Коннекторы, роли исполнителей и список известных сред задаёт организация. Нижний уровень может убрать коннектор или пометить ещё одну среду производственной.&lt;br&gt;Список, которого не дал ни один пакет, означает «ничего», а не «без проверки». Пакет с ошибкой не подключается целиком, а с ним и уровни ниже. Уровни выше продолжают работать. Пакет с ошибкой назван в начале сессии и в списке сценариев.&lt;br&gt;Манифесты проверяются по итогу слияния всех уровней: предел человека действует на сценарий проекта." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1090" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p20" name="20. События"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 1. О чём клиент сообщает ядру" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Событие клиента" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что делает ядро" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="400" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Что будет без события" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="55" width="350" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Начало сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;готовит вход: состояние, дела, память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="400" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;агент начинает без контекста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="95" width="350" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Запрос человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="300" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;открывает свободную задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="151" width="400" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;задача откроется на первом действии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="151" width="350" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Перед действием&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="300" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;решает: разрешить, спросить, отложить, отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="207" width="400" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;барьеры не действуют&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="207" width="350" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;После действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="300" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;пишет факт и результат в журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="263" width="400" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;нет фактов для проверки и крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="263" width="350" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Запуск и отчёт подчинённого&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="300" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;связывает с задачей, проверяет отчёт, закрывает его вопросы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="319" width="400" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;подчинённые вне учёта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="319" width="350" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Конец хода&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="300" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;закрывает задачу, вопрос без ответа это «нет»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="375" width="400" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;свободная задача ждёт срока&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="375" width="350" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Перед сжатием контекста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="300" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;отмечает задачу сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="431" width="400" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;после сжатия агент не знает о задаче&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="431" width="350" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Конец сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="487" width="300" height="46" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;пишет состояние, закрывает задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="487" width="400" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;память не пополняется сама&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="487" width="350" height="46" as="geometry"/></mxCell><mxCell id="c30" value="Событие «перед действием» единственное, без которого харнес не может быть барьером. Остальные события ухудшают работу постепенно.&lt;br&gt;Действие, которое началось после вопроса, это «да» человека, даже если оно упало. Прерванное действие не считается ни «да», ни «нет»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p21" name="21. Решения"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Клиент · 2. Что ядро возвращает клиенту" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Решение ядра" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="280" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что должен уметь клиент" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="55" width="400" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Если клиент не умеет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="55" width="370" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;выполнить действие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="95" width="400" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;не применимо&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="370" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Отказать с причиной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="159" width="280" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;не выполнять и показать причину агенту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="159" width="400" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;харнес не может быть барьером&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="159" width="370" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="223" width="280" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;показать вопрос с выбором и вернуть ответ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="223" width="400" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;вопрос идёт текстом или уведомлением&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="223" width="370" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отложить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="287" width="280" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;не выполнять и сообщить, что действие в очереди&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="287" width="400" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;действие считается отказом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="287" width="370" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Добавить во вход&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="351" width="280" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;передать агенту текст от харнеса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="351" width="400" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;вход задачи только через файл состояния&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="351" width="370" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Вернуть отчёт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="280" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;не завершать ход и передать замечание&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="415" width="400" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;проверка только записывает итог&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="415" width="370" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Ядро всегда возвращает решение в одном формате. Перевод в форму конкретного клиента делает адаптер." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p22" name="22. Детекторы"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 2. Детекторы: что считают и что предлагают" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Детектор" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="240" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что считает" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Порог" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="55" width="150" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Что предлагает" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="55" width="310" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Повтор цепочки действий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="240" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;одна последовательность в разных задачах&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="95" width="360" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3 задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="95" width="150" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;скрипт сбора или сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="95" width="310" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Повтор договоров&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="147" width="240" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;похожие разовые манифесты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="147" width="360" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;3 договора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="147" width="150" height="44" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;постоянный сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="147" width="310" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Повтор одобрений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="199" width="240" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;один вид действия, ответ всегда «да»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="199" width="360" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="199" width="150" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;действие в конверт сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="199" width="310" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Повтор ошибки инструмента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="251" width="240" height="44" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;одна ошибка одного инструмента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="251" width="360" height="44" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;3 раза&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="251" width="150" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ловушка в память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="251" width="310" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Модель сильнее нужной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="303" width="240" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;нет возвратов и подъёмов на сценарии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="303" width="360" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="303" width="150" height="44" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;понизить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="303" width="310" height="44" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Модель слабее нужной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="240" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;частые подъёмы и возвраты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="355" width="360" height="44" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="355" width="150" height="44" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;повысить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="355" width="310" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Частые возвраты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="407" width="240" height="44" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;доля FAIL у сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="407" width="360" height="44" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="407" width="150" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;править сценарий, решает человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="407" width="310" height="44" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Неиспользуемый сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="459" width="240" height="44" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;нет запусков&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="459" width="360" height="44" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;срок из пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="459" width="150" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;отключить сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="459" width="310" height="44" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Запись без ссылок&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="511" width="240" height="44" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;нет ссылок на запись памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="511" width="360" height="44" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;срок из пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="511" width="150" height="44" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;перевести в «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="511" width="310" height="44" as="geometry"/></mxCell><mxCell id="c43" value="Детектор это функция над строками журнала. Он не читает тексты и не вызывает модель. Новый детектор добавляется в ядро вместе с видом предложения и способом замера.&lt;br&gt;«Повтор одобрений» предлагает сузить вопрос до конкретного сценария. Он никогда не предлагает снять барьер целиком." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1090" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p23" name="23. Виды предложений"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 3. Виды предложений и класс автономии каждого" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Предложение" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что меняет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Класс" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Перевести запись в «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="360" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="95" width="360" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Новая ловушка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="360" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="151" width="360" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Отключить сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="360" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;состояние сценария в пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="207" width="360" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Понизить или повысить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="360" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;манифест, в пределах пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="263" width="360" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Новый сценарий без записи наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="360" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;манифест в пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="319" width="360" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Новый сценарий с записью наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="360" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;манифест и конверт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="375" width="360" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Действие в конверт сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="360" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;конверт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="431" width="360" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Новый скрипт сбора или проверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="487" width="360" height="46" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;исполняемый код в пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="487" width="330" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="487" width="360" height="46" as="geometry"/></mxCell><mxCell id="c30" value="Класс задан видом изменения, а не уверенностью крафта. Всё, что расширяет запись, добавляет исполняемый код или трогает барьеры, утверждает человек.&lt;br&gt;Крафт не предлагает менять ядро, контракты и слои правил. Таких видов предложений нет." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p24" name="24. Классы автономии"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 4. Где нужен человек, а где нет" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c4" value="обратимо и локально" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="72" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Сводка состояния в конце сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Запись фактов в журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Сохранение памяти с историей версий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Закрытие простаивающей сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ротация и очистка журнала&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="386" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Сбор данных скриптом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="300" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Само с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c12" value="обратимо, влияет на будущие ответы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="442" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Новая запись в памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Закрытие дела по внешнему статусу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отключение неиспользуемого сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Предложение крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c18" value="необратимо или уходит наружу" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="812" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Запись в рабочую среду&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Слияние изменений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Сообщение от имени человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ослабление барьера&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Решение с высокой ценой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="386" width="300" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Утверждение договора задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Класс каждого действия и срок вето задаёт пакет. Пакет может перевести действие только в более строгий класс.&lt;br&gt;В правом столбце от человека нужна одна кнопка, без текста. Харнес не должен зависеть от дисциплины человека." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1050" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Запуск и ответ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 1. Что такое проверка: вход, запуск, ответ" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Вход&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;отпечаток состояния работы&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="190" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Запуск&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ядро, с пределом времени&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="80" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Ответ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PASS, FAIL или нет ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="80" width="190" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Свидетельство&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что проверено и когда&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="80" width="190" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ответ с отпечатком&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="80" width="190" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;b&gt;Что получает проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;отпечаток состояния работы&lt;br&gt;параметры задачи&lt;br&gt;право читать то же, что исполнитель&lt;br&gt;записи наружу у проверки нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Что она возвращает&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PASS или FAIL&lt;br&gt;без ответа: причина, код выхода, конец текста ошибок&lt;br&gt;отпечаток работы, которая проверена&lt;br&gt;у сверки цитат: ошибки по находкам&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Когда она запускается&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;в конце хода, когда агент сказал «готово»&lt;br&gt;до отчёта: число запусков задаёт пакет&lt;br&gt;повторно после срока выдержки&lt;br&gt;никогда не запускается самим агентом&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c15" value="Проверка это команда из пакета проекта или встроенный вид проверки. Ядро запускает её само и само читает ответ.&lt;br&gt;Агент видит ответ и свидетельство, но не участвует в их получении. Он может запустить проверку до отчёта, если пакет дал число таких запусков: ответ ничего не принимает и возврат не тратит.&lt;br&gt;Ответ без свидетельства не принимается: «PASS» без указания, что именно проверено, считается отсутствием ответа." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Виды проверок"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 2. Пять видов проверок в деталях" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Вид" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="170" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что запускается" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="55" width="250" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Что считается PASS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="55" width="240" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Свидетельство" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="55" width="200" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Метка итога" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="55" width="190" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Команда&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="170" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;скрипт пакета check/&lt;имя&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="250" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="240" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="95" width="200" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="95" width="190" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Артефакт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="163" width="170" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;скрипт пакета: поиск объекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="163" width="250" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="163" width="240" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="163" width="200" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="163" width="190" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Внешнее состояние&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="231" width="170" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;скрипт пакета: чтение через коннектор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="231" width="250" height="56" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;скрипт напечатал PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="231" width="240" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ответ скрипта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="231" width="200" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;проверен результат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="231" width="190" height="56" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Сверка цитат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="299" width="170" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;сравнение ссылок с источником&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="299" width="250" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;все ссылки найдены&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="299" width="240" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;список сверенного&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="299" width="200" height="56" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;проверена форма&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="299" width="190" height="56" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="170" height="56" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;вопрос с выбором&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="367" width="250" height="56" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;ответ «да»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="367" width="240" height="56" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;кто и когда ответил&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="367" width="200" height="56" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;утверждено человеком&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="367" width="190" height="56" as="geometry"/></mxCell><mxCell id="c33" value="Человек может принять результат, который проверка не приняла сверх предела возвратов: метка «утверждено человеком». Сверка цитат читает до 10 находок и идёт не дольше 5 секунд.&lt;br&gt;Проверка может состоять из нескольких частей. Итог PASS только если все части дали PASS. При FAIL в ответе названа каждая часть, которая не прошла.&lt;br&gt;Новый вид проверки это изменение контракта. Новая команда проверки это изменение пакета проекта.&lt;br&gt;Вид «Человек» нужен там, где итог нельзя проверить кодом. Он честнее, чем слабая автоматическая проверка." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Привязка к состоянию"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 3. Привязка ответа к состоянию работы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Работа сделана&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент сказал «готово»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Отпечаток&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;снимает ядро&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;на этом состоянии&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Ответ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;хранит отпечаток&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Отпечаток&lt;br&gt;тот же?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="928" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Задача закрыта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="230" width="190" height="56" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Ответ недействителен&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="230" width="180" height="56" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value='&lt;b&gt;Что входит в отпечаток&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;коммит и изменённые файлы работы&lt;br&gt;новые файлы работы&lt;br&gt;версия самой проверки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Когда ответ недействителен&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;работа изменилась после проверки&lt;br&gt;проверка изменилась после ответа&lt;br&gt;прошёл срок годности ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Выдержка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;внешнее состояние меняется со временем&lt;br&gt;проверка повторяется через срок&lt;br&gt;PASS засчитан после второго ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="350" height="150" as="geometry"/></mxCell><mxCell id="c19" value="Без привязки зелёный ответ можно получить на одном состоянии и закрыть задачу на другом. Привязка делает такой обход невозможным. Зелёный ответ скрипта без отпечатка работы это не ответ. Исключение называет манифест: результат не лежит в каталоге (запись памяти, состояние системы).&lt;br&gt;Выдержка нужна для операций: «алерты не горят» сразу после выкладки ещё ничего не значит. Срок выдержки задаёт манифест." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Агент и проверка"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 4. Что агент может и чего не может" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Может&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="530" height="320" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Запустить проверку до отчёта, если пакет дал число запусков&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Видеть ответ и свидетельство&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Исправлять работу после FAIL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Сказать, что проверка неверна, и передать это человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Не может&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="530" height="390" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Запустить проверку сам и принести её ответ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Объявить PASS текстом отчёта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Изменить команду проверки или её настройки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Править тесты после FAIL без вопроса человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Удалить или переписать ответ проверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="361" width="490" height="50" as="geometry"/></mxCell><mxCell id="c14" value="После красного ответа файлы проверки, которые назвал манифест, переходят в защищённые: правка тестов и настроек идёт через вопрос человеку.&lt;br&gt;Это закрывает самый дешёвый способ получить PASS: ослабить проверку вместо исправления работы." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="530" height="150" as="geometry"/></mxCell><mxCell id="c15" value="Спор с проверкой разрешён и полезен: неверная проверка хуже отсутствующей. Но решает его человек, а не агент." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="480" width="530" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Сбои"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Проверка · 5. Сбои проверки и что с ними делать" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что случилось" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что делает ядро" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Проверка не ответила за предел времени&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;итог «не готово» с причиной и пределом, событие «проверка не ответила»; предел задаёт конфиг машины&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Проверка упала при запуске&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;нет ответа с причиной: код выхода и конец текста ошибок; возврат агенту, после предела вопрос человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Ответ без свидетельства&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;считается отсутствием ответа&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Ответ то PASS, то FAIL на одном состоянии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;оба ответа в журнале, число в сводке, предложение крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Проверки для этой работы нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;метка «не проверено», а не PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Проверка слишком дорогая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;число запусков до отчёта задаёт пакет, число возвратов манифест&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Ни один сбой не превращается в PASS. Молчание, ошибка и отсутствие проверки дают «не готово» или «не проверено».&lt;br&gt;Нестабильная проверка это отдельная беда: ей перестают верить. Поэтому расхождение ответов на одну работу и один отчёт видно в сводке и даёт предложение крафта." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
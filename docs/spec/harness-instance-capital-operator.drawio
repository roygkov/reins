<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Пакеты"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Экземпляр · 1. Пакеты: Capital.com, проекты, оператор" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Пакет организации: Capital.com&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="560" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Код и CI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;GitLab&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Задачи и документы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Jira, Confluence&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="167" width="300" height="52" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Связь&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Slack&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="229" width="300" height="52" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Журналы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;OpenSearch&lt;/font&gt;' style="
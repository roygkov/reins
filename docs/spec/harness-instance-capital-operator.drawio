alue="&lt;b&gt;Итог сессии&lt;br&gt;wrapup&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="190" height="50" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="508" width="230" height="50" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;средняя&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="508" width="220" height="50" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;состояние и дела,&lt;br&gt;без окна вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="710" y="508" width="200" height="50" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;отчёт о делах&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="508" width="220" height="50" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Проверка текста&lt;br&gt;text-check&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="567" width="190" height="50" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;черновик и доказательства&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="567" width="230" height="50" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;сильная&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="567" width="220" height="50" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="710" y="567" width="200" height="50" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;у каждого утверждения доказательство&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="567" width="220" height="50" as="geometry"/></mxCell><mxCell id="c53" value="Ни один из девяти манифестов не требует правки ядра. В рабочую систему пишет только ревью MR. Текст для людей проверяет text-check. Отчёт master → test и разбор тикета сценария не имеют: они идут свободной задачей." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1100" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Автономия"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Экземпляр · 6. Классы автономии в терминах reins" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="450" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Передача состояния в конце сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="105" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Коммит записей памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="169" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Состояние и шаги дел в сценарии wrapup&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="233" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Закрытие дела по конечному статусу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="297" width="300" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Архив журнала и недельная сводка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="361" width="300" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Сбор diff и тикета скриптом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="425" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Само с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="340" height="450" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Ловушка из сценария: 7 дней&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="105" width="300" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Удаление файла записи: 90 дней после вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="169" width="300" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Запись «устарела» по сроку auto_days:&lt;br&gt;7 дней&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="233" width="300" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Отключение сценария по сроку idle_days:&lt;br&gt;срок не задан&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="297" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Только оператор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="340" height="450" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Запись в прод&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="105" width="300" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Merge&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="169" width="300" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Сообщения в Slack, Jira, MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="233" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Решение с причиной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="297" width="300" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Правка пакета и его коммит&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="361" width="300" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Предложения крафта,&lt;br&gt;кроме записи «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="425" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Что остаётся за владельцем:&lt;/b&gt;&lt;br&gt;1. Решение пишет только человек командой reins memory decide.&lt;br&gt;2. Пакеты коммитит владелец; записи памяти коммитит харнес (memory_commit).&lt;br&gt;3. Срок auto_days в пакете 7 дней: предложение перевести запись в «устарела» применяется само. Срок idle_days не задан.&lt;br&gt;Барьеры на прод, конфигурацию reins и ~/.claude остаются как есть." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1050" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Порядок работ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Экземпляр · 7. Порядок работ и что брали у аналогов (план от 10 ноября, итог на 13 ноября)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;1. Манифест и сценарий «Ревью MR»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Покрывает 35 сессий из 60.&lt;br&gt;Сбор diff скриптом, средняя модель,&lt;br&gt;проверка: цитата у каждой находки.&lt;br&gt;&lt;i&gt;Образец формата: Goose recipes, sprint-contract&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;2. Сценарий «Отчёт master → test»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Триггер по расписанию.&lt;br&gt;Условие запуска без модели.&lt;br&gt;Слабая модель, фиксированная форма.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;3. Сценарий «Релиз»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Запись в границах конверта.&lt;br&gt;Проверка: тег на месте, алерты не горят.&lt;br&gt;&lt;i&gt;Очередь отложенных операций:&lt;br&gt;claude-code-harness&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;4. Автономия обслуживания&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Автокоммит памяти, wrapup хуком,&lt;br&gt;кандидаты с окном вето,&lt;br&gt;нити по статусу MR.&lt;br&gt;&lt;i&gt;Очередь событий, затухание: agentmemory&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;5. Адаптер клиента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Кодек событий на каждый клиент.&lt;br&gt;Нужен для локальной модели.&lt;br&gt;&lt;i&gt;Образец: hookcodec и hosts.toml&lt;br&gt;в claude-code-harness&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;6. Крафт-модуль&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Детекторы кодом, порог 3 повтора,&lt;br&gt;замер эффекта после принятия.&lt;br&gt;&lt;i&gt;Гигиена журнала: continuous-learning&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="290"/><mxPoint x="220" y="290"/></Array></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Итог на 13.11.2026: шаги 1, 5, 6 сделаны. Шаг 4 сделан, кроме wrapup хуком: состояние пишет агент в сценарии wrapup. Шаг 2 не сделан: сценария отчёта нет, все сценарии запускает команда. Шаг 3 сделан иначе: релиз solr утверждает человек, проверки тега и алертов кодом нет.&lt;br&gt;Шаги 1–3 это пакет: три манифеста, ядро не меняется. Шаги 4–6 это работа над моделью: они делают ядро универсальным и полезны любому экземпляру.&lt;br&gt;Чего нет ни у одного аналога: проверка «готово», которую агент не может подделать; поиск паттернов кодом; применение по молчанию с окном вето и замером." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1060" height="100" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="18" height="18" as="geometry"/></mxCell><mxCell id="c16" value="пакет экземпляра" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="669" width="260" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="696" width="18" height="18" as="geometry"/></mxCell><mxCell id="c18" value="работа над моделью" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="695" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
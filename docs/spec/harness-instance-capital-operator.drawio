;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Тесты проекта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проверка project-tests&lt;br&gt;личного пакета&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="167" width="300" height="52" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;ums&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;изменённые *FunctionalTest,&lt;br&gt;./mvnw verify&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="229" width="300" height="52" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;uaa-backend&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;mvn -q test&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="291" width="300" height="52" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;solr&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;mvn -q test&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="353" width="300" height="52" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;reins&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;npm test&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="415" width="300" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Личный пакет: оператор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="340" height="560" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Правила работы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;pack.md: язык текстов,&lt;br&gt;проверка текста для людей&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="105" width="300" height="52" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Claude Code, плагин reins&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="167" width="300" height="52" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Предел уровня модели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сильная&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="229" width="300" height="52" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Сценарии&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;девять манифестов, страница 5&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="291" width="300" height="52" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;docs/reins-memory,&lt;br&gt;коммитит харнес&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="353" width="300" height="52" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;Сроки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;удалённая запись 90 дней,&lt;br&gt;семь конечных статусов дел&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="415" width="300" height="52" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Язык&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;русский в чате,&lt;br&gt;английский в Jira и MR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="477" width="300" height="52" as="geometry"/></mxCell><mxCell id="c27" value="Пределы задачи в пакете организации: 400 000 токенов, 10 записей, 2 исполнителя, 200 чтений через коннекторы, 3 проверки до отчёта, 2 сбоя инструмента подряд, 40 запросов в сессии до напоминания.&lt;br&gt;Экземпляр это модель плюс три пакета. Другой человек в другой организации заменяет только эту часть. Ядро и контракты остаются теми же." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1050" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Контекст"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Экземпляр · 2. Контекст с системами Capital.com" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Харнес&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reins&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="300" height="160" as="geometry"/></mxCell><mxCell id="c4" value="Оператор" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="40" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Расписание" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="440" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Клиент агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Claude Code&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Модели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Claude: сильная, средняя, слабая&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="240" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Системы Capital.com&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="860" y="230" width="280" height="320" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Код и CI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;GitLab, flux, пайплайны&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="275" width="240" height="70" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Прод&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;OpenSearch, Grafana, Postgres, Rancher&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="365" width="2
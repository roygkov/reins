<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Строка журнала"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 1. Строка журнала: общие поля каждого события" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Когда и что&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;время&lt;br&gt;версия схемы&lt;br&gt;вид события&lt;br&gt;источник: задача, политика, проверка,&lt;br&gt;исполнитель, память, крафт, харнес&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;К чему относится&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;задача&lt;br&gt;родительская задача&lt;br&gt;сессия&lt;br&gt;сценарий и его версия&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Кто&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;исполнитель: основной или подчинённый&lt;br&gt;роль исполнителя&lt;br&gt;уровень модели&lt;br&gt;клиент агента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="350" height="150" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Где&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проект&lt;br&gt;отпечаток состояния работы&lt;br&gt;пакет, из которого взято правило&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="350" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Данные события&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;поля зависят от вида события&lt;br&gt;только перечни, числа и отпечатки&lt;br&gt;строка это метка без пробелов&lt;br&gt;имя поля это идентификатор&lt;br&gt;свободного текста модели и человека нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="240" width="350" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Правила строки&lt;/b&gt;&lt;br&gt;1. Одна строка это одно событие. Строки только добавляются, прошлое не правится.&lt;br&gt;2. У строки есть версия схемы. Читатель пропускает поля, которых не знает.&lt;br&gt;3. Смысл поля не меняется. Новый смысл это новый вид события, а не новое значение старого поля.&lt;br&gt;4. Пишет только ядро. Агент не пишет в журнал и не меняет его.&lt;br&gt;5. Журнал хранит факты для кода. Тексты запросов, команд и отчётов в него не попадают: только вид, размер и отпечаток." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Виды событий"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 2. Виды событий по источникам" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;задача открыта&lt;br&gt;вид задачи определён, с причиной&lt;br&gt;договор предложен&lt;br&gt;договор утверждён&lt;br&gt;подготовка завершена&lt;br&gt;задача пропущена: работы нет&lt;br&gt;исполнение начато&lt;br&gt;отчёт подан&lt;br&gt;задача возвращена&lt;br&gt;ожидание человека&lt;br&gt;решение человека, в том числе «нет»&lt;br&gt;задача закрыта: метка итога, была ли правка&lt;br&gt;итог оспорен человеком&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение по действию&lt;br&gt;основание решения: слой и правило&lt;br&gt;конверт открыт&lt;br&gt;конверт закрыт&lt;br&gt;действие отложено&lt;br&gt;отложенное действие решено&lt;br&gt;попытка изменить защищённое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проверка запущена&lt;br&gt;ответ проверки: PASS или FAIL&lt;br&gt;проверка не ответила&lt;br&gt;ответ недействителен: работа изменилась&lt;br&gt;превышен предел возвратов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="350" height="230" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Исполнители и стоимость&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;исполнитель запущен&lt;br&gt;отчёт исполнителя получен&lt;br&gt;отчёт подтверждён или отклонён&lt;br&gt;уровень модели поднят&lt;br&gt;расход: токены, время, вызовы&lt;br&gt;инструмент дал ошибку&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Память и крафт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;память прочитана&lt;br&gt;запись использована&lt;br&gt;запись добавлена, изменена или удалена&lt;br&gt;паттерн найден&lt;br&gt;предложение создано&lt;br&gt;предложение применено или отклонено&lt;br&gt;замер эффекта&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Харнес&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сбой харнеса&lt;br&gt;превышено время шага&lt;br&gt;форма события клиента изменилась&lt;br&gt;уровень клиента определён&lt;br&gt;барьеры не действуют&lt;br&gt;итог слияния пакетов&lt;br&gt;пакет изменён&lt;br&gt;манифест отклонён при подключении&lt;br&gt;текст дан агенту: место и размер&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="350" height="230" as="geometry"/></mxCell><mxCell id="c9" value="Перечень видов закрыт: событие неизвестного вида в журнал не пишется. Новый вид добавляется в перечень кода. Версия строки растёт, когда меняется форма строки.&lt;br&gt;Группа «Харнес» это журнал о самом харнесе: по ней видно, можно ли доверять остальным строкам.&lt;br&gt;Источников семь: задача (группа «Контур»), политика, проверка, исполнитель, память, крафт, харнес. Источник это начало имени вида события." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1090" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Связи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 3. Что восстанавливается из строк" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Сценарий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;имя и версия&lt;br&gt;пакет-владелец&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="250" height="110" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;идентификатор&lt;br&gt;состояние&lt;br&gt;метка итога&lt;br&gt;стоимость&lt;br&gt;число возвратов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="240" width="250" height="160" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Исполнитель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;роль&lt;br&gt;уровень модели&lt;br&gt;клиент&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="250" height="130" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Событие&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;время&lt;br&gt;вид и источник&lt;br&gt;данные события&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="250" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Действие&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид, цель, среда&lt;br&gt;решение политики&lt;br&gt;основание решения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="250" height="150" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Предложение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид и порог&lt;br&gt;срок вето&lt;br&gt;итог и эффект&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="250" height="150" as="geometry"/></mxCell><mxCell id="c9" value="много : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="1 : много" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="1 : много" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="0 или 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="основано на" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="440"/><mxPoint x="790" y="440"/><mxPoint x="790" y="360"/></Array></mxGeometry></mxCell><mxCell id="c14" value="родительская" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;entryX=0;entryY=0.2;" edge="1" parent="1" source="c4" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="205"/><mxPoint x="420" y="205"/><mxPoint x="420" y="272"/></Array></mxGeometry></mxCell><mxCell id="c15" value="Журнал это только строки событий.&lt;br&gt;&lt;br&gt;Состояние задачи, предложения крафта и очередь лежат в своих файлах состояния. Журнал их не заменяет: по нему считают, а состояние из него не восстанавливают.&lt;br&gt;&lt;br&gt;Производную базу для быстрых запросов можно построить и удалить без потерь." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="340" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Гигиена"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 4. Что из происходящего попадает в журнал" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что произошло" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что записано" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Команда или вызов инструмента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;исход, вид действия, среда, имя инструмента коннектора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Вывод инструмента коннектора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;имя инструмента и размер вывода; сам вывод не пишется&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Запрос человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;вид задачи и причина выбора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Отчёт агента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;метка итога; у отчёта сценария размер и отпечаток&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Обращение к памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;идентификатор записи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Текст, в котором может быть секрет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ничего: в строке только коды, числа и идентификаторы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Правила хранения&lt;/b&gt;&lt;br&gt;1. Очистка идёт до записи, а не после: то, что не записано, не надо удалять.&lt;br&gt;2. Журнал растёт до предела размера, затем старая часть уходит в архив. Срок хранения архива задаёт пакет.&lt;br&gt;3. Сбой записи не останавливает задачу. Сам сбой считается и виден в метриках.&lt;br&gt;4. Журнал лежит локально. Наружу уходит только то, что разрешил человек.&lt;br&gt;5. Файлы журнала входят в защищённое: агент не может их изменить или удалить." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Метрики"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 5. Метрики: что считается из строк и зачем" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Метрика" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Из каких событий" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c5" value="На какой вопрос отвечает" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="55" width="390" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Доля результатов с проверенным итогом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;закрыт сценарий или запрос с правкой; в долю идёт только проверка результата, проверка формы и одобрение человека видны частями&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="360" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Можно ли верить слову «готово»?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="390" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Возвраты на задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;задача возвращена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="157" width="360" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Достаточно ли ясен сценарий?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="157" width="390" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Доля вопросов гейта с ответом «да»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="300" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;решение по действию, решение человека; ответ относится к проекту вопроса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="219" width="360" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Где барьер стал шумом?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="219" width="390" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Доля запусков без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;задача пропущена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="281" width="360" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Работает ли условие запуска?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="281" width="390" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Стоимость на сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;расход задач сценариев&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="343" width="360" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Что стоит удешевить?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="343" width="390" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Использование памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;память прочитана, запись использована&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="405" width="360" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Какие записи живые?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="405" width="390" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Эффект принятых предложений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="467" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;предложение применено, замер эффекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="467" width="360" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Улучшает ли харнес сам себя?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="467" width="390" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Сбои харнеса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="529" width="300" height="50" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;сбой, превышено время, форма события изменилась&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="529" width="360" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Можно ли верить самому харнесу?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="529" width="390" height="50" as="geometry"/></mxCell><mxCell id="c30" value="Метрики считает код. Модель их не считает и не толкует. Каждая метрика отвечает на один вопрос человека: метрика без вопроса удаляется.&lt;br&gt;Сводка для человека это восемь чисел и их изменение за неделю.&lt;br&gt;Расход сессии до первого события харнеса в стоимость не входит. Числа считаются по машине или по одному проекту.&lt;br&gt;Ряд по дням или неделям для программы снаружи даёт команда ядра с версией формы; показ делает экземпляр." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Кто пишет и читает"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Журнал · 6. Кто пишет в журнал и кто его читает" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;только добавление&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="485" y="290" width="200" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Пишет только ядро&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="420" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Контур&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="220" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Политика&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="256" width="220" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Проверка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="342" width="220" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Крафт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Читают&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="270" height="520" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Метрики&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сводка человеку&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="115" width="230" height="68" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Детекторы крафта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;поиск повторов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="207" width="230" height="68" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Сводка недели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;числа и предложения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="299" width="230" height="68" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Передача сессии&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;счётчики прошлой сессии&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="
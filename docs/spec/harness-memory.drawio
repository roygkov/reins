<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Состав"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 1. Из чего состоит память" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Источник истины&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="340" height="330" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Записи, читаемые человеком&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="300" height="52" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;История и откат каждой записи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="181" width="300" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Одна запись это одна единица&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="247" width="300" height="52" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Меняется редко, растёт медленно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="313" width="300" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Поиск&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="340" height="330" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Поиск по словам идёт по самим записям&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="115" width="300" height="52" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Отдельного индекса нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="181" width="300" height="52" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Пересобирать нечего&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="247" width="300" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Своих данных не хранит&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="313" width="300" height="52" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Рабочее состояние&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="340" height="330" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Счётчики использования&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="115" width="300" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Очередь кандидатов и сроки вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="181" width="300" height="52" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Время последней ссылки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="247" width="300" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;История не нужна&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="313" width="300" height="52" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="c13" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value='&lt;b&gt;Пишет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ядро, по правилам классов автономии&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="525" height="60" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Читают&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вход задачи, человек, крафт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="440" width="525" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Источник истины это единственное, что нельзя потерять. Рабочее состояние восстанавливается или обнуляется без вреда. Производного индекса нет: поиск читает записи.&lt;br&gt;Счётчик использования меняется при каждой задаче. Поэтому он живёт отдельно и не засоряет историю записей. Черновик и срок вето лежат в файле самой записи.&lt;br&gt;Способ хранения выбирает экземпляр. Контракт требует свойства, а не технологию.&lt;br&gt;Состояние проекта и шаги дел пишет агент в сценарии итога сессии; решение пишет только человек." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1090" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Типы записей"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 2. Типы записей и общие поля" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Решение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что решено&lt;br&gt;почему&lt;br&gt;что отвергнуто&lt;br&gt;когда пересмотреть&lt;br&gt;какую запись заменяет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ловушка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;неочевидный факт о системе&lt;br&gt;привязка к месту в работе&lt;br&gt;дата последней проверки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Дело&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что не закончено&lt;br&gt;следующий шаг&lt;br&gt;внешний статус, если он есть&lt;br&gt;сколько дней перенесено&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Состояние&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;где мы сейчас&lt;br&gt;что делать дальше&lt;br&gt;что не проверено&lt;br&gt;переписывается целиком&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="60" width="265" height="170" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Общие поля каждой записи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;идентификатор · тип · дата · источник: задача и сценарий · привязка: место в работе и его отпечаток&lt;br&gt;статус: черновик, действует, устарела, заменена, удалена, закрыта · область: проект или все проекты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1090" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Правила записей&lt;/b&gt;&lt;br&gt;1. Решение без причины не принимается: через месяц оно бесполезно.&lt;br&gt;2. В память не пишут то, что видно из самой работы или её истории изменений.&lt;br&gt;3. Предпочтения человека, например язык и тон, это личный пакет, а не память.&lt;br&gt;4. Запись становится общей по слову человека: команда share." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1090" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Жизненный цикл"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 3. Жизненный цикл записи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Наблюдение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Кандидат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Устарела&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="210" width="150" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Удалена&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вето человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Заменена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Закрыта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;дело закончено&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="150" height="44" as="geometry"/></mxCell><mxCell id="c10" value="агент" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="срок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="нет ссылок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="вето" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="222"/><mxPoint x="460" y="112"/></Array></mxGeometry></mxCell><mxCell id="c14" value="вето" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="новая о том же" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.4;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="конец дела" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="150"/><mxPoint x="805" y="150"/></Array></mxGeometry></mxCell><mxCell id="c17" value="подтверждена" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="175"/><mxPoint x="627" y="175"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Запись агента в сценарии. Слово человека и принятое предложение крафта действуют сразу, без черновика&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Ждёт в очереди. Вето одной кнопкой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Попадает во вход задач. Ссылки считаются&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Нет ссылок за срок или место в работе изменилось&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="150" height="90" as="geometry"/></mxCell><mxCell id="c22" value="Переходы делает код. Человек нужен в трёх местах: вето на запись, решение с причиной, возврат удалённой или устаревшей записи.&lt;br&gt;Привязка к месту в работе хранит отпечаток. Если место изменилось, запись уходит в «Устарела», а не продолжает влиять на ответы.&lt;br&gt;Удаление это вето человека: смена статуса из любого состояния, кроме «Заменена» и «Закрыта». Содержимое остаётся, человек может вернуть запись в «Действует», пока не прошёл срок хранения удалённых записей из пакета: после него файл стирается.&lt;br&gt;Новое состояние действует сразу и заменяет прежнее: окна вето у него нет. Дело получает шаг и конец командой: закрытое дело уходит в «Закрыта»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Откуда берутся записи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 4. Откуда берутся записи и какой у них класс автономии" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Источник" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что появляется" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="55" width="380" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Класс" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="55" width="290" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Человек сказал «делаем так»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="380" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;решение с причиной, действует сразу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="95" width="380" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="95" width="290" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Агент в сценарии записал ловушку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="380" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;черновик ловушки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="157" width="380" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="157" width="290" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Сценарий итога сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="380" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;новое состояние пишет агент&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="219" width="380" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="219" width="290" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отметка «это было неверно»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="380" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;пометка записи, её вес падает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="281" width="380" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="281" width="290" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Сценарий или человек закрыл дело&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="380" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;дело закрыто, файл остаётся&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="343" width="380" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="343" width="290" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Запись меняет барьеры или пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="380" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;это не память: предложение человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="405" width="380" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="405" width="290" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Человеку не нужно ничего запускать, чтобы память пополнялась. Его участие это вето и решение с причиной.&lt;br&gt;Сценарий или человек даёт делу шаг: новый следующий шаг, счёт дней переноса идёт с нуля.&lt;br&gt;Срок вето задаёт пакет. Кандидат с пометкой источника виден в недельной сводке." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1090" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Чтение и использование"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 5. Как запись попадает во вход задачи и как считается использование" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="До задачи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="24" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ключи задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;место, термины, сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Поиск по записям&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;без индекса&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="95" width="190" height="64" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value='&lt;b&gt;Отбор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;совпадение, свежесть, ссылки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="95" width="190" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value='&lt;b&gt;Предел размера&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;лишнее не входит&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="95" width="190" height="64" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value='&lt;b&gt;Вход задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;записи с идентификаторами&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="95" width="190" height="64" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="После задачи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="24" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Отчёт и находки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;текст исполнителя&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="190" height="64" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Поиск идентификаторов&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код, без модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="255" width="190" height="64" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value='&lt;b&gt;Счётчик ссылок&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;по каждой записи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="255" width="190" height="64" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value='&lt;b&gt;Вес при отборе&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;растёт от ссылок&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="255" width="190" height="64" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Что значит «использована»&lt;/b&gt;&lt;br&gt;Запись использована, если исполнитель сослался на неё по идентификатору. Выдача записи в поиске использованием не считается.&lt;br&gt;Запись без ссылок за 180 дней уходит в «Устарела» сама; решение не стареет. Крафт предлагает это раньше: через 30 дней или срок пакета. Запись с отметкой «это было неверно» теряет вес сразу. Вторая отметка выводит запись из работы.&lt;br&gt;Во вход идут записи с идентификаторами, чтобы на них можно было сослаться и чтобы ссылку нашёл код.&lt;br&gt;В начале сессии состояние проекта идёт целиком, открытые дела идут со следующим шагом, остальные записи по строке.&lt;br&gt;Поиск по словам даёт короткие строки: идентификатор, тип, проект, начало текста. Запись целиком даёт команда show." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1090" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Обязательства"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 6. Что обязано хранилище и что гарантирует ядро" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Хранилище обязано&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="530" height="440" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Запись читаема человеком без особых инструментов&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;У записи есть история, изменение можно откатить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;У записи есть тип, источник и статус&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Работает без сети&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Параллельная запись не теряет данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="361" width="490" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Удаление оставляет след&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="490" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Ядро гарантирует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="530" height="440" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Пишет только по правилам классов автономии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Очищает секреты до записи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Не даёт агенту менять записи в обход правил&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Считает использование по ссылкам&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ищет по записям без индекса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="361" width="490" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Параллельная запись это требование практики: несколько сессий в день пишут в одну память. Самый простой способ его выполнить: одна запись в одной единице хранения." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Что не память"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Память · 7. Что в память не кладут и где этому место" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Хочется записать в память" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Правильное место" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Факт о ходе задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Текст разговора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Транскрипт клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Предпочтение человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Личный пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Правило проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Пакет проекта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Секрет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Хранилище секретов системы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;То, что видно из самой работы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Нигде: читается из источника&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Память хранит то, чего нет больше нигде: почему так решили, на чём споткнулись и что осталось сделать. Всё остальное дублирует источник и устаревает." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
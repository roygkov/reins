 пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="271" width="150" height="38" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;понизить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="271" width="310" height="38" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Модель слабее нужной&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="240" height="38" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;частые подъёмы уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="315" width="360" height="38" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="315" width="150" height="38" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;повысить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="315" width="310" height="38" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Частые возвраты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="359" width="240" height="38" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;доля FAIL у сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="359" width="360" height="38" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="359" width="150" height="38" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;править сценарий, решает человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="359" width="310" height="38" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Неиспользуемый сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="403" width="240" height="38" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;нет запусков&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="403" width="360" height="38" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;срок idle_days пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="403" width="150" height="38" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;ядро отключает, человек включает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="403" width="310" height="38" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Запись без ссылок&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="240" height="38" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;нет ссылок на запись памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="447" width="360" height="38" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;30 дней или срок пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="447" width="150" height="38" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;перевести в «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="447" width="310" height="38" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Мёртвая запись памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="491" width="240" height="38" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;выдачи записи агенту без ссылки в отчёте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="491" width="360" height="38" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;5 выдач&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="491" width="150" height="38" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;перевести в «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="491" width="310" height="38" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Мера выше порога&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="240" height="38" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;дни, когда мера харнеса выше порога пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="535" width="360" height="38" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;2 дня из 7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="660" y="535" width="150" height="38" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;причину ищет человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="535" width="310" height="38" as="geometry"/></mxCell><mxCell id="c51" value="Детектор это функция над строками журнала. Он не читает тексты и не вызывает модель. Новый детектор добавляется в ядро вместе с видом предложения и способом замера.&lt;br&gt;«Повтор одобрений» предлагает сузить вопрос до конкретного сценария. Он никогда не предлагает снять барьер целиком.&lt;br&gt;Ещё два детектора: повтор вопроса одного правила; проверка, которая дала PASS и FAIL на одну работу и один отчёт. Готовая правка есть у трёх предложений: манифест из договора, запись «устарела», ловушка. Остальные правки человек делает сам.&lt;br&gt;Число вопросов и ответов по правилу детекторы берут из кода метрик: сводка, показ и крафт не дают разных чисел. «Мёртвая запись» не судит решения. «Мера выше порога» читает пороги раздела targets пакета." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1090" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Виды предложений"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 3. Виды предложений и класс автономии каждого" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Предложение" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что меняет" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Класс" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="55" width="360" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Перевести запись в «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="360" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;с окном вето, срок задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="95" width="360" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Новая ловушка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="360" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;память&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="151" width="360" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Откат принятого предложения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="360" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;то, что изменило предложение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="207" width="360" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Понизить или повысить уровень модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="360" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;манифест, в пределах пакета&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="263" width="360" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Новый сценарий без записи наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="360" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;манифест в пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="319" width="360" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Новый сценарий с записью наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="360" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;манифест и конверт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="375" width="360" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Действие в конверт сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="360" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;конверт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="431" width="360" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Новый скрипт сбора или проверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="487" width="360" height="46" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;исполняемый код в пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="487" width="330" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="487" width="360" height="46" as="geometry"/></mxCell><mxCell id="c30" value="Класс задан видом изменения, а не уверенностью крафта. Всё, что расширяет запись, добавляет исполняемый код или трогает барьеры, утверждает человек.&lt;br&gt;Крафт не предлагает менять ядро, контракты и слои правил. Таких видов предложений нет." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Формулировка"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 4. Как код формулирует предложение" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Паттерн&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;виды событий, счётчики, идентификаторы&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Код&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;строка из фактов, готовая правка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="80" width="300" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Предложение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;у человека или с окном вето&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="300" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Из чего текст&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид паттерна&lt;br&gt;имя правила, сценария или инструмента&lt;br&gt;счётчик и период&lt;br&gt;день счёта&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Чего в тексте нет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;текстов запросов и отчётов&lt;br&gt;вывода инструментов&lt;br&gt;содержимого рабочих систем&lt;br&gt;секретов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Готовая правка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;манифест из повторного договора&lt;br&gt;запись в «устарела»&lt;br&gt;ловушка для памяти&lt;br&gt;удаление манифеста при откате&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="350" height="170" as="geometry"/></mxCell><mxCell id="c11" value="Текст состоит только из фактов, которые записал код. В нём нет текста из внешнего мира, поэтому через него нельзя подсунуть инструкцию.&lt;br&gt;Модель предложение не пишет: слабая модель на этом шаге не дала бы больше, чем строка из фактов, а стоила бы вызова.&lt;br&gt;Готовую правку делает принятие человека. Сама по сроку применяется только запись «устарела»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Замер эффекта"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 5. Замер эффекта после принятия" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что принято" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что сравнивается до и после" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="370" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Когда откат" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="55" width="350" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Манифест из договора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;возвраты на задачу сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="370" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;возвраты выросли&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="95" width="350" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Понижение уровня модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="330" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;возвраты и подъёмы уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="157" width="370" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;возвраты или подъёмы выросли&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="157" width="350" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Повышение уровня модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="330" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;доля подъёмов уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="219" width="370" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;подъёмов не стало меньше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="219" width="350" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Действие в конверте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="330" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;число вопросов правила&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="281" width="370" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;вопросов не стало меньше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="281" width="350" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Ловушка в памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="330" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;сбои того же инструмента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="343" width="370" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;сбоев не стало меньше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="343" width="350" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Запись «устарела»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="330" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;человек вернул запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="405" width="370" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;запись вернули&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="405" width="350" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Мера выше порога&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="467" width="330" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;число дней выше порога&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="467" width="370" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;таких дней стало больше&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="467" width="350" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Правила замера&lt;/b&gt;&lt;br&gt;1. Сравнение идёт с тем же сценарием до изменения, а не с общим средним.&lt;br&gt;2. Нужен минимум задач до и после. Если данных мало, итог «не измерено», и предложение остаётся с этой пометкой.&lt;br&gt;3. Откат это тоже предложение: его решает человек.&lt;br&gt;4. Изменение, которое нельзя измерить, не принимается по сроку." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1090" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Ограничения"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 6. Ограничения, которые держат крафт в рамках" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Риск" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Ограничение" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Поток предложений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;предел предложений в неделю, задаёт пакет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Предложение по одному случаю&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;порог повторов для каждого детектора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Навязчивость&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;отклонённое не предлагается, пока паттерн не вырос вдвое&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Оптимизация частого вместо важного&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;человек помечает сценарий «не трогать»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Расход на сам крафт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;детекторы и текст предложения без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Крафт мешает работе&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;крафт выключается одной настройкой, остальное работает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Крафт видит, что происходит часто. Он не видит, что важно. Редкая операция с высокой ценой ошибки для него невидима.&lt;br&gt;Поэтому решение о принятии остаётся суждением человека там, где цена высока, и становится автоматическим только там, где изменение обратимо и измеримо." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Недельная сводка"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Крафт · 7. Недельная сводка: единственное, что человек видит от крафта" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Числа недели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;восемь метрик журнала&lt;br&gt;изменение к прошлой неделе&lt;br&gt;расход по сценариям&lt;br&gt;меры против порогов пакета&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="350" height="190" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Применено само&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что изменилось и откуда взялось&lt;br&gt;ссылка на паттерн&lt;br&gt;отменить одной кнопкой&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="350" height="190" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Ждёт срока&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;черновики памяти в окне вето&lt;br&gt;сколько дней осталось&lt;br&gt;вето одной командой&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="350" height="190" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Нужно решение человека&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;предложения класса «только человек»&lt;br&gt;черновик изменения целиком&lt;br&gt;принять или отклонить одной кнопкой&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="535" height="170" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Откаты и «не измерено»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что отменено по замеру и почему&lt;br&gt;что принято, но эффект не измерен&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="595" y="290" width="535" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Сводку можно не читать: всё, что применяется само, обратимо и измеряется.&lt;br&gt;Раздел «Нужно решение человека» не устаревает и не применяется по сроку. Если его не разбирать, харнес просто не меняется в этих местах.&lt;br&gt;Сводка это файл и уведомление. Отдельного экрана для неё нет. Срок сводки задаёт пакет: без числа пакета семь дней." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
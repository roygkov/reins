;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.205;entryY=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="правила, манифесты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;entryX=0.8;entryY=0;" edge="1" parent="1" source="c15" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c8" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Синее это контракты: их заполняют пакеты.&lt;br&gt;Фиолетовое это ядро: оно одно для всех.&lt;br&gt;Серое заменяемо: клиент, модели, системы, пакеты." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="310" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Сквозной путь"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 3. Сквозной путь одной задачи и где он описан подробно" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;1. Триггер&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;команда, расписание, событие&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;клиент · 1, манифест · 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;2. Вид задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сценарий, договор или свободная&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ядро · 5, 6 и 7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;3. Сбор и условие&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;скрипт без модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;манифест · 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value='&lt;b&gt;4. Правила и конверт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;слияние пакетов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;пакеты · 2, манифест · 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value='&lt;b&gt;5. Исполнение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;каждое действие через политику&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ядро · 3, коннектор · 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value='&lt;b&gt;6. Исполнители&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;поручения и проверка отчётов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ядро · 4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;7. Проверка готовности&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;возврат до предела, метка итога&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;манифест · 4, проверка · 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value='&lt;b&gt;8. Решение человека&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;одна кнопка или очередь&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;модель · 6, клиент · 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value='&lt;b&gt;9. Запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;журнал, память, состояние&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;журнал · 2, память · 4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value='&lt;b&gt;10. Развитие&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;детекторы, предложения, сводка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;крафт · 1 и 7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="135"/><mxPoint x="1140" y="280"/><mxPoint x="140" y="280"/></Array></mxGeometry></mxCell><mxCell id="c32" value="Под каждым шагом указан файл и страница с подробностями. Модель участвует в шагах 5 и 6. Остальное делает код, включая текст предложений шага 10." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1090" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Общие правила"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 4. Правила, которые действуют во всей модели" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Доверие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="535" height="310" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;«Готово» доказывается фактом, а не текстом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="495" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Отчёт исполнителя это заявление&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="167" width="495" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Нет ответа проверки значит «не готово»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="229" width="495" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Метка итога всегда показывается человеку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="291" width="495" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Барьеры&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="595" y="60" width="535" height="310" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Нижний уровень может только ужесточить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="105" width="495" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Запись наружу утверждает человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="167" width="495" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Агент не меняет правила, журнал, очереди и пакеты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="229" width="495" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Без события «до» харнес говорит, что барьеров нет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="291" width="495" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Экономия и развитие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="535" height="310" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Что считается кодом, не идёт через модель&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="495" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Харнес не зависит от дисциплины человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="497" width="495" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Изменение без способа замера не принимается само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="559" width="495" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Неиспользуемое отключается&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="621" width="495" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Независимость&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="595" y="390" width="535" height="310" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Модель не знает организации, проекта, человека и клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="435" width="495" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Контракт требует свойства, а не технологию&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="497" width="495" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Новая точка расширения после второго случая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="559" width="495" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Экземпляр может поправить модель, но не наоборот&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="621" width="495" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Открытые вопросы"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 5. Что не разложено и что не решено" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Вопрос" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="420" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Почему он важен" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="55" width="650" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Сходство цепочек действий и договоров&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="420" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;на нём стоят два главных детектора крафта, без модели оно будет грубым&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="650" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Пороги и сроки по умолчанию&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="420" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;их даст только практика, сейчас это «задаёт пакет»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="157" width="650" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Перенос существующих инструментов на модель&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="420" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;что переиспользуется, что переписывается: это вопрос экземпляра&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="219" width="650" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Команда людей и облачное исполнение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="420" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;сознательно вне модели, оттуда придёт первая большая переделка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="281" width="650" height="50" as="geometry"/></mxCell><mxCell id="c13" value="Первые два вопроса касаются крафта и порогов. Их можно закрыть на первом сценарии. Остальные решаются по ходу.&lt;br&gt;Закрыты: как запрос становится видом задачи (ядро, страницы 6 и 7); контракты проверки и коннектора (отдельные файлы); формат манифеста и пакета это JSON с закрытым списком полей." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1090" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Словарь"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 6. Словарь: один термин, одно значение" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Харнес&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;обвязка вокруг агента: вход, барьеры, проверка, память, журнал&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="350" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ядро&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;часть харнеса, одинаковая для всех: контур, политика, журнал, крафт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="350" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;цикл задачи от триггера до записи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="350" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение по каждому действию: разрешить, спросить, отложить, отказать&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="350" height="64" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Слой правил&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;набор правил одного уровня: ядро, организация, проект, человек&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="136" width="350" height="64" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Конверт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;действия записи, разрешённые на время одной задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="136" width="350" height="64" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Контракт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;обязательство между ядром и расширением&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="350" height="64" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Пакет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;настройки одного уровня: правила, манифесты, скрипты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="212" width="350" height="64" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Манифест&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;файл из восьми разделов, который описывает сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="212" width="350" height="64" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Сценарий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;повторяемая работа с постоянным манифестом&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="350" height="64" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Договор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;разовый манифест, который человек утвердил для одной задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="288" width="350" height="64" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Свободная задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;работа без манифеста, итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="288" width="350" height="64" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;команда с ответом PASS или FAIL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="350" height="64" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Метка итога&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;что именно проверено в результате&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="364" width="350" height="64" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Исполнитель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запуск модели с ролью и правами в рамках задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="364" width="350" height="64" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Коннектор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;способ читать или писать во внешнюю систему&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="350" height="64" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Адаптер&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;перевод событий клиента в формат ядра и обратно&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="440" width="350" height="64" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;строки фактов для кода, без текста&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="440" width="350" height="64" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Запись памяти&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение, ловушка, дело или состояние&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="350" height="64" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Крафт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;поиск повторов в журнале и предложения по изменению харнеса&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="516" width="350" height="64" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Детектор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;функция над журналом, которая находит один вид повтора&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="516" width="350" height="64" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Окно вето&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;срок, после которого предложение применяется само&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="350" height="64" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;Очередь решений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;отложенные действия, которые ждут человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="592" width="350" height="64" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Экземпляр&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;модель плюс пакеты конкретной организации и человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="592" width="350" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Норма и пояснения"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Обзор · 7. Какие страницы обязательны, а какие поясняют" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Файл" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="260" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Страницы спецификации" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="55" width="380" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Пояснения, примеры, границы" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="55" width="410" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;harness-overview&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="260" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2, 4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="380" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1, 3, 5, 6, 7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="95" width="410" height="40" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;harness-model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="141" width="260" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="320" y="141" width="380" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1, 2, 3, 5, 6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="141" width="410" height="40" as="geometr
<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Описание действия"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 1. Что коннектор сообщает о каждом своём действии" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Имя&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;по нему действие узнаётся&lt;br&gt;одно имя: запись или чтение по шаблону&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Вид&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;чтение или запись&lt;br&gt;изменение в дереве: только у клиента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Цель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;на что действует&lt;br&gt;шаблон с параметрами задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Среда&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;рабочая, проверочная, локальная&lt;br&gt;определяется по маркеру из пакета&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="70" width="265" height="120" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Обратимость&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;можно ли отменить&lt;br&gt;необратимое всегда решает человек&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Наружу&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;видит ли результат другой человек&lt;br&gt;сообщение, комментарий, публикация&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="315" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Чувствительность&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;секреты и личные данные&lt;br&gt;даже при чтении&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Предел чтений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сколько чтений на задачу&lt;br&gt;задаёт пакет, сверх него вопрос&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="865" y="210" width="265" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Как коннектор устроен внутри, ядру неважно: это может быть инструмент клиента, команда или скрипт. Важно только описание действий.&lt;br&gt;Описание лежит в пакете организации. Свои инструменты клиента описывает адаптер. По нему политика принимает решение, не понимая смысла действия.&lt;br&gt;Вызов инструмента без описания считается записью неизвестного вида.&lt;br&gt;Изменение в рабочем дереве разрешено по умолчанию: его покрывает отпечаток состояния работы." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1090" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Сопоставление"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 2. Как действие агента сопоставляется с описанием" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Действие агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вызов или команда&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Разбор кодом&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;имя, параметры&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Есть&lt;br&gt;описание?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="484" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Вид, цель, среда&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;из описания&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="726" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;решение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="948" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Неизвестный вызов&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;инструмента: это запись&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="230" width="190" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="спросить человека" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1038" y="262"/></Array></mxGeometry></mxCell><mxCell id="c15" value='&lt;b&gt;Вызов инструмента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;описание называет действие из списка пакета&lt;br&gt;поля входа дают цель&lt;br&gt;среду называет описание&lt;br&gt;поле входа совпало с шаблоном пакета: чтение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="350" height="150" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Команда оболочки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;разбор на части кодом, часть за частью&lt;br&gt;опасные классы команд знает ядро&lt;br&gt;команда вне этих классов разрешена&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="350" height="150" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Скрипт сбора или проверки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;объявлен в пакете заранее&lt;br&gt;только чтение&lt;br&gt;в песочнице запись из скрипта это отказ&lt;br&gt;получает путь конфигурации харнеса&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="350" height="150" as="geometry"/></mxCell><mxCell id="c18" value="Сопоставление делает код по имени и параметрам. Модель в нём не участвует и не может переименовать действие.&lt;br&gt;Правило умолчания: неопознанный вызов инструмента считается записью и идёт к человеку. Команда оболочки вне опасных классов разрешена: вопрос на каждую команду делает работу невозможной." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1090" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Среды"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 3. Решение по умолчанию: вид действия и среда" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Действие" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Среда" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Решение по умолчанию" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="55" width="390" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Чтение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;локальная или проверочная&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="330" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="390" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Чтение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;рабочая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="151" width="330" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;разрешить, факт в журнале&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="151" width="390" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Чтение чувствительного&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="207" width="330" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="207" width="390" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Запись обратимая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;локальная или проверочная&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="263" width="330" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;спросить, конверт может разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="263" width="390" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Запись наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="319" width="330" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;одно утверждение на задачу по конверту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="319" width="390" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;рабочая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="375" width="330" height="46" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;человек на каждое действие; конверт и пауза не действуют&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="375" width="390" height="46" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Запись необратимая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;любая&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="431" width="330" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек на каждое действие; пауза не действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="431" width="390" height="46" as="geometry"/></mxCell><mxCell id="c27" value="Среда определяется по маркеру: имя соединения, адрес или параметр. Маркеры задаёт пакет организации.&lt;br&gt;Если среду определить нельзя, она считается рабочей.&lt;br&gt;Пакет может сделать любое из этих решений строже. Мягче сделать нельзя." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1090" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Чтение и вывод"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 4. Чтение тоже несёт риск" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Риск" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что делает контракт" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;В выводе есть секрет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;действие помечено чувствительным, решает человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Вывод слишком большой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ядро вывод не режет: это дело клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;В выводе есть текст с указаниями агенту&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;вывод помечен как данные из внешнего источника&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Чтение стоит дорого или нагружает систему&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;предел числа чтений на задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Чтение меняет состояние системы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;это запись, а не чтение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Всё, что коннектор вернул, это данные, а не указания. Харнес сообщает агенту источник каждого вывода.&lt;br&gt;Защита от подсунутых указаний не в том, чтобы найти их в тексте. Она в том, что запись идёт через политику, какой бы текст ни прочитал агент.&lt;br&gt;Пятая строка важна: «чтение», которое что-то запускает или помечает, описывается как запись." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="940" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Составные действия"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 5. Когда агент пишет код, который делает много действий" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Агент пишет код&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;много вызовов внутри&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Виден каждый&lt;br&gt;внутренний вызов?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="220" height="84" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Политика на каждом вызове&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;как для обычных действий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="250" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Весь код это одна запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;неизвестного вида&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="150" width="250" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="220" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Способ исполнения кода" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="380" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Где стоит барьер" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="420" height="30" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Среда исполнения сообщает о каждом вызове&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="320" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;на каждом вызове, внутри среды&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="320" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Среда ограничена только чтением&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="384" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;барьер не нужен, запись невозможна&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="384" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Среда ничего не сообщает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="448" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;на всём коде целиком, как на записи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="448" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Барьер, который смотрит на текст кода, ненадёжен: один и тот же вызов можно записать сотней способов. Надёжен только барьер на самом вызове.&lt;br&gt;Поэтому код для чтения и сбора безопасен в ограниченной среде, а код с записью требует среды, которая сообщает о вызовах." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="530" width="940" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Обязательства"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Коннектор · 6. Что обязан коннектор и что гарантирует ядро" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Коннектор обязан&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="530" height="380" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Описать каждое своё действие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Не иметь действий без описания&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Сообщать итог: успех или ошибка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Не хранить секреты в описании&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Соблюдать предел вывода&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="361" width="490" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ядро гарантирует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="530" height="380" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Каждое действие проходит политику&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="490" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Неопознанный вызов инструмента это запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="169" width="490" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Запись возможна только через гейт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="233" width="490" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Решение о действии пишется в журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="297" width="490" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Вывод помечен источником&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="361" width="490" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Новая система подключается новым коннектором в пакете организации. Ядро при этом не меняется.&lt;br&gt;Коннектор без описаний работает, но каждое его действие идёт к человеку. Описание это способ убрать лишние вопросы, а не способ получить доступ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1090" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
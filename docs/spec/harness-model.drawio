ote;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Уровни"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 2. Три уровня: пакеты, контракты, ядро" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Пакеты настройки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="760" height="150" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Организация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;системы, маркеры рабочих сред&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="105" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Проект&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;проверки, сценарии проекта&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="105" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Человек&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;роль, разрешения, модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="105" width="220" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Контракты расширения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="240" y="270" width="760" height="150" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Сценарий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;манифест&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="315" width="132" height="80" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PASS или FAIL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="406" y="315" width="132" height="80" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Коннектор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;инструмент, скрипт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="552" y="315" width="132" height="80" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;события&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="698" y="315" width="132" height="80" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;типы записей&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="844" y="315" width="132" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Ядро&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="240" y="480" width="760" height="150" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;цикл задачи&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="525" width="164" height="80" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Политика&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;барьеры&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="525" width="164" height="80" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;факты и метрики&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="632" y="525" width="164" height="80" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Крафт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;паттерны, предложения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="818" y="525" width="164" height="80" as="geometry"/></mxCell><mxCell id="c18" value="заполняют" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="подключаются к" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Меняется часто.&lt;br&gt;Пишет организация, проект, человек." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Меняется редко.&lt;br&gt;Каждый контракт это обязательство совместимости." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="190" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Не знает об организации, проекте и человеке.&lt;br&gt;Остаётся маленьким." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="190" height="60" as="geometry"/></mxCell><mxCell id="c23" value="Правило политики: нижний уровень может только ужесточать барьеры. Проект не снимает защиту, заданную организацией. Агент не правит ни один уровень." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="760" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Варианты использования"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 3. Варианты использования харнеса" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Харнес&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="50" width="640" height="600" as="geometry"/></mxCell><mxCell id="c4" value="Расписание&lt;br&gt;или событие" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="85" width="40" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Человек" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Системы" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="40" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Выполнить сценарий&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="95" width="230" height="54" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Выполнить задачу по договору&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="163" width="230" height="54" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Выполнить свободную задачу&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="231" width="230" height="54" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Утвердить действие&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="299" width="230" height="54" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Принять результат&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="367" width="230" height="54" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Отметить неверный ответ&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="435" width="230" height="54" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Отклонить предложение&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="503" width="230" height="54" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Добавить сценарий или пакет&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="571" width="230" height="54" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Запросить данные&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="92" width="220" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Проверить фактами&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="172" width="220" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Пройти гейт&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="252" width="220" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry">
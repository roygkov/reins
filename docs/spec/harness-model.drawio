t="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="18" height="18" as="geometry"/></mxCell><mxCell id="c36" value="вариант использования" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="559" width="260" height="20" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="18" height="18" as="geometry"/></mxCell><mxCell id="c38" value="общий вариант, «include»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="585" width="260" height="20" as="geometry"/></mxCell><mxCell id="c39" value="Задача по договору исполняется как сценарий с разовым манифестом.&lt;br&gt;Свободная задача идёт без манифеста: харнес даёт ей память и гейт, но не проверку готовности." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="220" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Классы автономии"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 4. Где нужен человек, а где нет" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Само&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c4" value="обратимо и локально" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="72" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Сводка состояния в конце сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Запись фактов в журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Сохранение памяти с историей версий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Закрытие простаивающей сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ротация и очистка журнала&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="386" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Сбор данных скриптом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="300" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Само с окном вето&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c12" value="обратимо, влияет на будущие ответы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="442" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Новая запись в памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Закрытие дела по внешнему статусу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отключение неиспользуемого сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Предложение крафта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Только человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="340" height="480" as="geometry"/></mxCell><mxCell id="c18" value="необратимо или уходит наружу" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="812" y="88" width="316" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Запись в рабочую среду&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="300" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Слияние изменений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="194" width="300" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Сообщение от имени человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="258" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ослабление барьера&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="322" width="300" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Решение с высокой ценой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="386" width="300" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Утверждение договора задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Класс каждого действия и срок вето задаёт пакет. Пакет может перевести действие только в более строгий класс.&lt;br&gt;В правом столбце от человека нужна одна кнопка, без текста. Харнес не должен зависеть от дисциплины человека." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1050" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Донастройка"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 5. Как готовый харнес донастраивается под конкретную работу" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;1. Ядро и адаптер клиента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Ставится один раз.&lt;br&gt;Не содержит ничего об организации,&lt;br&gt;проекте и человеке.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;2. Пакет организации&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Коннекторы к системам.&lt;br&gt;Маркеры рабочих сред.&lt;br&gt;Общие барьеры.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;3. Пакет проекта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Команда проверки проекта.&lt;br&gt;Сценарии, общие для команды.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;4. Личный пакет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Роль и частые задачи.&lt;br&gt;Разрешения в границах уровней выше.&lt;br&gt;Модели по умолчанию.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;5. Первый манифест&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Под самую частую работу.&lt;br&gt;На нём проверяется контракт.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;6. Дальше по данным&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Крафт показывает повторы.&lt;br&gt;Новый сценарий после третьего повтора.&lt;br&gt;Неиспользуемое отключается.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="320" height="170" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="290"/><mxPoint x="220" y="290"/></Array></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Проверка независимости: каждый элемент модели должен оставаться верным для другого человека в другой организации с другим клиентом. Всё, что не проходит эту проверку, живёт в пакете, а не в модели." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1060" height="70" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="18" height="18" as="geometry"/></mxCell><mxCell id="c16" value="ядро" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="659" width="260" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="686" width="18" height="18" as="geometry"/></mxCell><mxCell id="c18" value="пакеты" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="685" width="260" height="20" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="18" height="18" as="geometry"/></mxCell><mxCell id="c20" value="сценарии" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="86" y="711" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Способы работы"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 6. Как человек работает с харнесом" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Ядро&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;одна программа&lt;br&gt;с командной строкой&lt;br&gt;&lt;br&gt;политика, журнал,&lt;br&gt;состояние задач, крафт&lt;br&gt;&lt;br&gt;работает без модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="70" width="240" height="550" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Через клиент агента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="830" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Человек" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Клиент агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;окно или терминал&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="115" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Адаптер клиента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;переводит события&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="115" width="200" height="60" as="geometry"/></mxCell><mxCell id="c8" value="разговор" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="событие, решение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.136;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Без человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="830" height="190" as="geometry"/></mxCell><mxCell id="c12" value="Расписание&lt;br&gt;или событие" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Команда харнеса&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запуск сценария&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="295" width="190" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Нужна&lt;br&gt;модель?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="285" width="170" height="80" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Клиент без окна&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ограниченные инструменты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="295" width="170" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Итог без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="385" width="170" height="40" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.464;" edge="1" parent="1" source="c15" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Только решение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="830" height="150" as="geometry"/></mxCell><mxCell id="c23" value="Человек" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="495" width="40" height="80" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Одна кнопка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;утвердить или отклонить&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="510" width="200" height="60" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;Уведомление&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;клиент, система, мессенджер&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="510" width="200" height="60" as="geometry"/></mxCell><mxCell id="c26" value="ждёт решения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.855;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="решение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c24" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="650"/><mxPoint x="1010" y="650"/></Array></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Команды самого харнеса, без модели:&lt;/b&gt; показать состояние и очередь; утвердить или отклонить отложенное действие; запустить сценарий; показать метрики.&lt;br&gt;&lt;b&gt;Требования к клиенту:&lt;/b&gt; сообщать о действии до его выполнения; уметь задать вопрос с выбором; запускаться без окна с ограниченным набором инструментов.&lt;br&gt;Своего экрана у харнеса нет. Он нужен только тогда, когда очередь решений становится большой." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1100" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Контекст"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Модель · 1. Контекст: харнес и его окружение" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Харнес&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;контур управления агентом:&lt;br&gt;вход, барьеры, проверка фактами,&lt;br&gt;память, журнал, развитие&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="300" height="160" as="geometry"/></mxCell><mxCell id="c4" value="Человек" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="40" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Расписание&lt;br&gt;или событие" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="440" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Клиент агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;любой клиент, который сообщает&lt;br&gt;о действии до и после него&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Модели&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;облачные и локальные,&lt;br&gt;разных уровней&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="240" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Внешние системы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="860" y="230" width="280" height="320" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Код и сборка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;репозитории, проверки, выкладка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="275" width="240" height="70" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Рабочие среды&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;журналы, метрики, данные&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="365" width="240" height="70" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Задачи и связь&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;трекеры, сообщения, документы&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="455" width="240" height="70" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;читаемые записи&lt;br&gt;с историей и откатом&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="430" y="570" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="цель, утверждение, приёмка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=
<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Состав ядра"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 1. Состав ядра и места подключения контрактов" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Ядро&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="730" height="640" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Контур&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="235" y="140" width="335" height="250" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Диспетчер событий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;принимает события клиента&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="180" width="295" height="52" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Исполнитель сценария&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;читает манифест, ведёт шаги&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="246" width="295" height="52" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Состояние задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;хранит харнес, а не агент&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="312" width="295" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Политика&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="325" height="250" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Слои правил&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ядро, организация, проект, человек&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="180" width="295" height="52" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Решатель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;разрешить, спросить, отложить, отказать&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="246" width="295" height="52" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Очередь отложенных действий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;утверждает только человек&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="312" width="295" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Журнал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="235" y="430" width="700" height="120" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Запись событий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;единая схема&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="468" width="210" height="52" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Гигиена&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;секреты, обрезка, ротация&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="482" y="468" width="210" height="52" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Метрики&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;считает код&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="714" y="468" width="210" height="52" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Крафт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="235" y="590" width="700" height="120" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Детекторы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;повторы, код без модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="628" width="210" height="52" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Очередь предложений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;окно вето&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="482" y="628" width="210" height="52" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Замер эффекта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;до и после принятия&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="714" y="628" width="210" height="52" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;события и способ отказа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="26" width="210" height="52" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Сценарий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;манифест&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="160" height="56" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PASS или FAIL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="160" height="56" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;типы записей&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="160" height="56" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Коннектор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;инструмент, скрипт&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="237" width="160" height="56" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.19;" edge="1" parent="1" source="c21" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.51;" edge="1" parent="1" source="c22" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.83;" edge="1" parent="1" source="c23" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c8" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.24;entryY=0;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.77;entryY=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="Синие блоки это контракты. Ядро не знает, чем они заполнены.&lt;br&gt;&lt;br&gt;Каждое действие агента идёт из контура в политику. Каждое решение идёт в журнал." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="180" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Состояния задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 2. Контур: состояния задачи и переходы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Нет задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Подготовка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сбор и условие&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Исполнение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент действует&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Публикация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог принят, конверт действует&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="140" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;фактами&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="140" height="50" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Закрыта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;с меткой итога&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="140" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ожидает человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Закрыта без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c11" value="триггер" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="есть работа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="нечего делать" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отчёт подан" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="PASS, записей нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="PASS, есть записи в конверте" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="470"/><mxPoint x="800" y="470"/></Array></mxGeometry></mxCell><mxCell id="c17" value="конец публикации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="FAIL: вернуть отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="130"/><mxPoint x="570" y="130"/></Array></mxGeometry></mxCell><mxCell id="c19" value="гейт спросил, решение принято" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="FAIL сверх предела возвратов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="445"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Правила контура&lt;/b&gt;&lt;br&gt;1. Состояние хранит харнес. Агент не может сам перевести задачу в «Закрыта».&lt;br&gt;2. Каждый переход пишется в журнал. Исключение: вход в публикацию своей строки не имеет.&lt;br&gt;3. Предел возвратов задаёт манифест: от 0 до 5. После предела решает человек.&lt;br&gt;4. Свободная задача идёт без манифеста: шаг «Проверка» пропускается, итог помечается «не проверено».&lt;br&gt;5. Сбой самого харнеса не блокирует работу: задача продолжается, сбой пишется в журнал.&lt;br&gt;6. У задачи может быть несколько исполнителей. Предел исполнителей и токенов задаёт пакет. Задача сверх предела токенов ждёт человека. Подробности на странице 4.&lt;br&gt;7. Задача с договором проходит те же состояния. Перед «Подготовкой» человек утверждает договор. Подробности на странице 5.&lt;br&gt;8. У события есть источник. Агент сообщает «готово» и вопрос. Ответ проверки даёт только харнес. Утверждение даёт только человек.&lt;br&gt;9. Состояние задачи это один файл вне рабочего дерева. Запись в него идёт по одному: два процесса не меняют одну задачу сразу.&lt;br&gt;10. Сбой сбора закрывает задачу с меткой «не проверено». Предел времени и размера действует и на процессы, которые запустил скрипт.&lt;br&gt;11. Принятый результат задачи с записями в конверте переводит задачу в публикацию: метка итога уже известна, конверт ещё действует.&lt;br&gt;12. Публикацию завершает агент, человек, срок или изменение работы. После этого конверт закрыт и задача закрыта." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1050" height="262" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Решение политики"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 3. Политика: как принимается решение по одному действию" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Действие агента&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;команда или вызов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="160" height="60" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Разбор кодом&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вид, цель, среда&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="230" width="180" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Слои правил&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="240" height="340" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Ядро&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запреты без исключений&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="200" height="56" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Организация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;рабочие среды, общие барьеры&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="202" width="200" height="56" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Проект&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;защищённые пути и ветки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="274" width="200" height="56" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Человек&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;личные разрешения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="346" width="200" height="56" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Свод решений&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;берётся самое строгое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Конверт задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;из манифеста&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="170" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Разрешить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Спросить человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="160" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Отложить в очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="270" width="160" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Отказать&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="350" width="160" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="снимает вопрос&lt;br&gt;в своих границах" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Правила политики&lt;/b&gt;&lt;br&gt;1. Слой может только ужесточить решение слоя выше. Строгость растёт так: разрешить, спросить, отложить, отказать.&lt;br&gt;2. Конверт задачи заменяет «спросить» на «разрешить» только для действий, названных в манифесте, сразу или после одного утверждения на задачу. Запрет слоя он не снимает.&lt;br&gt;3. Решение и его основание пишутся в журнал. Текст команды в журнал не пишется, если в нём может быть секрет.&lt;br&gt;4. Запись агента в состояние, память и конфигурацию харнеса это отказ. Правка пакета, кода харнеса и настроек клиента это вопрос человеку.&lt;br&gt;5. Отложенное действие утверждает только человек. Перед командой утверждения клиент спрашивает человека.&lt;br&gt;6. Если клиент не сообщает о действии до его выполнения, харнес прямо говорит человеку, что барьеры не действуют.&lt;br&gt;7. Права подчинённого исполнителя не шире прав родителя. Он действует в конверте задачи родителя, своего конверта у него нет.&lt;br&gt;8. Решение по умолчанию это решение слоя ядра: чтение и изменение в рабочем дереве разрешены, запись требует вопроса. Нижний слой его не ослабляет.&lt;br&gt;9. Запись в производственную или неизвестную среду утверждает человек на каждое действие. Конверт на неё не действует.&lt;br&gt;10. Исход слоя вне перечня считается отказом." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1100" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Несколько исполнителей"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 4. Несколько исполнителей в одной задаче" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;конверт задачи,&lt;br&gt;предел исполнителей и токенов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="340" height="70" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Основной исполнитель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ведёт задачу, раздаёт поручения&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="280" height="60" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Читающий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;только чтение&lt;br&gt;возвращает вывод, а не содержимое&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Проверяющий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;только чтение&lt;br&gt;не видит рассуждений автора&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Исполняющий часть&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;запись в своей области&lt;br&gt;области не пересекаются&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Проверка отчёта&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;кодом или независимым исполнителем&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="280" height="60" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Журнал&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;у строки есть&lt;br&gt;родительская задача&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="570" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="поручение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="подтверждённый вывод" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="550"/><mxPoint x="1100" y="550"/><mxPoint x="1100" y="220"/></Array></mxGeometry></mxCell><mxCell id="c18" value="каждый шаг" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="528" y="620"/></Array></mxGeometry></mxCell><mxCell id="c19" value="Оправдано, когда нужна независимость, изоляция чтения или разные права.&lt;br&gt;Не оправдано для последовательной работы с записью и для малых задач." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="330" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;1. Права подчинённого не шире прав родителя.&lt;br&gt;2. Отчёт подчинённого это заявление, а не факт.&lt;br&gt;3. У каждой строки журнала есть родительская задача.&lt;br&gt;4. Предел исполнителей и токенов на задачу задаёт пакет.&lt;br&gt;5. Исполнители общаются только через основного.&lt;br&gt;6. Сбор данных делает скрипт, а не исполнитель.&lt;br&gt;7. Если пакеты дают уровням имена моделей, в задаче сценария модель подчинённого не выше уровня задачи. Модель, которую клиент не может назвать, даёт отказ.&lt;br&gt;8. Отказ подчинённому это решение в журнале с правилом и ролью." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="440" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Задача с договором"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 5. Задача с договором: «вот задача, сделай»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;текст или ссылка от человека&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Предложение договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;агент, только чтение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Проверка договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код, как у манифеста&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;b&gt;Утверждение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;человек, одна кнопка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Разовый манифест&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;живёт одну задачу&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="70" width="190" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;b&gt;Работа сама&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;без окна, возвраты по проверке&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Упёрлась?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="262" y="200" width="190" height="84" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Итог с меткой&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;человеку&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;журнал и память&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Повтор договоров&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;крафт предлагает сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="928" y="210" width="190" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Вопрос или очередь&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="262" y="320" width="190" height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1023" y="172"/><mxPoint x="135" y="172"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="ответ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="345"/></Array></mxGeometry></mxCell><mxCell id="c25" value='&lt;b&gt;Что входит в договор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;цель одной фразой&lt;br&gt;границы: что трогать и что нет&lt;br&gt;проверка готовности: вид и команда&lt;br&gt;нужные действия записи&lt;br&gt;пределы: токены, возвраты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Три вида задач&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;сценарий: постоянный манифест из пакета&lt;br&gt;задача с договором: разовый манифест&lt;br&gt;свободная задача: без манифеста,&lt;br&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;Когда договор не помогает&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;у задачи нет проверяемого итога&lt;br&gt;тогда договор честно ставит метку&lt;br&gt;«не проверено»&lt;br&gt;работа идёт сама, но итогу верить нельзя&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="350" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;1. Договор предлагает агент, утверждает человек. Без утверждения работа не начинается.&lt;br&gt;2. Договор проверяется тем же кодом, что манифест. Он не может просить больше, чем разрешают пакеты.&lt;br&gt;3. После утверждения договор не меняется. Если задаче нужно больше, она останавливается: человек даёт идти дальше или завершает её.&lt;br&gt;4. Предел токенов обязателен. Договор без него не принимается.&lt;br&gt;5. Запись наружу остаётся за человеком: по конверту с одним утверждением или через очередь." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Вид задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 6. Как запрос становится видом задачи" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что пришло" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="330" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Как узнаётся" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="340" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Вид задачи" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="55" width="190" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Кто решает" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="55" width="170" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Расписание или событие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;привязка в манифесте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="340" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="95" width="190" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="95" width="170" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Команда с именем сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="147" width="330" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;имя сценария&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="147" width="340" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="147" width="190" height="44" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="147" width="170" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Вход известной формы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="199" width="330" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;форма совпала с одним манифестом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="199" width="340" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;сценарий&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="199" width="190" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;код, с отменой&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="199" width="170" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Вход подходит нескольким сценариям&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="251" width="330" height="44" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;совпало больше одного манифеста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="251" width="340" height="44" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;по выбору&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="251" width="190" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="251" width="170" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Команда «задача» или кнопка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="303" width="330" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;явное слово человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="303" width="340" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;договор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="303" width="190" height="44" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;человек&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="303" width="170" height="44" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Запрос человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="330" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;событие клиента&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="355" width="340" height="44" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;свободная задача&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="355" width="190" height="44" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="355" width="170" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Действие без запроса&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="407" width="330" height="44" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;факт действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="407" width="340" height="44" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;свободная задача&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="750" y="407" width="190" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;код&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="407" width="170" height="44" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;Разговор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;действий нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;Свободная задача&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;итог «не проверено»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b&gt;Предложение договора&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;работа не останавливается&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b&gt;Договор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;дальше как сценарий&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="490" width="190" height="60" as="geometry"/></mxCell><mxCell id="c39" value="запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="порог" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="кнопка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Правила выбора&lt;/b&gt;&lt;br&gt;1. Вид задачи определяют имя, форма входа и факты. Слова запроса вид не определяют.&lt;br&gt;2. Модель может подсказать человеку подходящий сценарий. Запустить сценарий по догадке она не может.&lt;br&gt;3. Ошибка в сторону свободной задачи видна: итог помечен «не проверено». Ошибка в сторону сценария дорога. Поэтому сценарий требует имени или формы входа.&lt;br&gt;4. Свободная задача растёт по фактам: порог действий записи задаёт пакет. Договор предлагается, но не навязывается.&lt;br&gt;5. Выбранный вид и причина выбора пишутся в журнал." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1090" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Границы задачи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ядро · 7. Где задача начинается и где кончается" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что произошло" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="380" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Что происходит с задачей" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Проверка дала PASS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="380" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;нет записей в конверте: закрыта. Есть: публикация, конверт действует&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="420" height="52" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Новый сценарий в той же сессии&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="166" width="380" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;старая задача приостановлена, её конверт молчит до возврата&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="166" width="420" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Действие вне конверта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="380" height="52" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;обычное решение политики, конверт не расширяется&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="232" width="420" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Нет действий дольше срока&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;задача закрыта как незавершённая, итог «не проверено»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="298" width="420" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Сессия закончилась&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="364" width="380" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;состояние задачи записано, её можно продолжить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="420" height="52" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Человек отклонил договор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="380" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;работа остаётся свободной задачей&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Конверт живёт не дольше задачи. Разрешение, выданное для одного сценария, не переходит на то, что человек попросил следом.&lt;br&gt;В одной сессии может быть много задач. У одной задачи может быть много сессий. Задачу ведёт харнес, а не сессия клиента.&lt;br&gt;Каждый запрос человека открывает свободную задачу. Она закрывается, когда агент остановился." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="940" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
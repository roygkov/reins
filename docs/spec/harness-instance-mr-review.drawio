<mxfile host="app.diagrams.net" agent="generator"><diagram id="p1" name="1. Сейчас и с манифестом"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 1. Как ревью идёт сейчас и как пойдёт по манифесту" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Сейчас&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="220" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Запрос&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;«сделай ревью» и ссылка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Чтение MR моделью&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;много вызовов, сильная модель&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value='&lt;b&gt;Черновики&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;правила тона из памяти&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value='&lt;b&gt;«Да, опубликуй»&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;текстом&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="705" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value='&lt;b&gt;Публикация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;вопрос гейта на каждую запись&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Отдельная сессия на каждое ревью. Находки не сверяются с кодом. Повторный запрос читает MR заново. Сессия не закрывается сама." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="1050" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;С манифестом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1090" height="300" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Команда&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ссылка на MR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Сбор скриптом&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;без модели&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value='&lt;b&gt;Ревью&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;средняя модель&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value='&lt;b&gt;Сверка цитат&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;код&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value='&lt;b&gt;Одно утверждение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;оператор называет находки&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value='&lt;b&gt;Публикация и запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;в границах конверта&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="160" height="70" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Конец без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="480" width="160" height="44" as="geometry"/></mxCell><mxCell id="c27" value="нет новых коммитов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Итог идёт с меткой «проверена форма». Журнал пишется сам. Состояние ревью не хранится: его даёт GitLab. Задачу закрывает команда reins finish." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="1050" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Манифест"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 2. Манифест сценария" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='{&lt;br&gt;&amp;nbsp;&amp;nbsp;"manifest":&amp;nbsp;1,&lt;br&gt;&amp;nbsp;&amp;nbsp;"name":&amp;nbsp;"mr-review",&lt;br&gt;&amp;nbsp;&amp;nbsp;"title":&amp;nbsp;"Ревью&amp;nbsp;MR",&lt;br&gt;&amp;nbsp;&amp;nbsp;"package":&amp;nbsp;"person",&lt;br&gt;&amp;nbsp;&amp;nbsp;"trigger":&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"kind":&amp;nbsp;"command",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"inputs":&amp;nbsp;[{"name":&amp;nbsp;"mr_url",&amp;nbsp;"type":&amp;nbsp;"url"}]&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;"collect":&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"script":&amp;nbsp;"collect/gitlab-mr",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"outputs":&amp;nbsp;["mr",&amp;nbsp;"files",&amp;nbsp;"diff",&amp;nbsp;"ticket",&amp;nbsp;"threads",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"memory_hits",&amp;nbsp;"worktree",&amp;nbsp;"risk_flags"],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"flags":&amp;nbsp;["has_new_commits"],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"timeout_s":&amp;nbsp;180,&amp;nbsp;"max_bytes":&amp;nbsp;2000000&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;"run_if":&amp;nbsp;"has_new_commits",&lt;br&gt;&amp;nbsp;&amp;nbsp;"model":&amp;nbsp;{"level":&amp;nbsp;"medium",&amp;nbsp;"raise_to":&amp;nbsp;"strong"},&lt;br&gt;&amp;nbsp;&amp;nbsp;"permissions":&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"read":&amp;nbsp;["gitlab",&amp;nbsp;"jira",&amp;nbsp;"memory",&amp;nbsp;"worktree"],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"write":&amp;nbsp;[{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"action":&amp;nbsp;"create-thread",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"target":&amp;nbsp;"mr/{mr_url}",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"env":&amp;nbsp;"work",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"limit":&amp;nbsp;10,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"confirm":&amp;nbsp;"once"&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}]&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;"done":&amp;nbsp;{"kind":&amp;nbsp;"citations",&amp;nbsp;"retries":&amp;nbsp;2,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"source":&amp;nbsp;"worktree",&amp;nbsp;"changed":&amp;nbsp;"files"},&lt;br&gt;&amp;nbsp;&amp;nbsp;"output":&amp;nbsp;{"format":&amp;nbsp;"list",&amp;nbsp;"max_items":&amp;nbsp;10,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"fields":&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"severity":&amp;nbsp;["blocking",&amp;nbsp;"should-fix",&amp;nbsp;"note"],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"confidence":&amp;nbsp;["confirmed",&amp;nbsp;"likely",&amp;nbsp;"question"]&lt;br&gt;&amp;nbsp;&amp;nbsp;}},&lt;br&gt;&amp;nbsp;&amp;nbsp;"memory":&amp;nbsp;{"write":&amp;nbsp;["pitfall"],&amp;nbsp;"class":&amp;nbsp;"veto"}&lt;br&gt;}' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="480" height="610" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;1. Триггер&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Команда «ревью» со ссылкой на MR. Событие «назначен ревьюером» добавится позже отдельным манифестом.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="570" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;2. Сбор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Скрипт читает MR, файлы, дифф, ключ тикета Jira и открытые треды. Записи памяти во вход добавляет харнес. Готовит рабочую копию на коммите MR.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="136" width="570" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;3. Условие запуска&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Есть коммиты после прошлого ревью этого MR. Иначе задача закрывается без модели.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="212" width="570" height="64" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;4. Модель&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Средняя. Подъём до сильной один раз на задачу командой reins raise. Подчинённых нет: глубокое ревью это отдельный манифест.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="288" width="570" height="64" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;5. Разрешения&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Читать GitLab, Jira, память и рабочую копию. Писать только новые треды в этот MR, до десяти, после одного утверждения.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="364" width="570" height="64" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;6. Проверка готовности&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Сверка цитат кодом. Метка итога: «проверена форма». Два возврата.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="570" height="64" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;7. Форма результата&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Список находок как данные. Ядро читает файл, строку и цитату. Важность и уверенность называет манифест. Не больше десяти.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="516" width="570" height="64" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;8. Запись в память&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Право записать ловушку, через окно вето.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="592" width="570" height="64" as="geometry"/></mxCell><mxCell id="c12" value="Язык комментариев и тон заданы в личном пакете, а не в манифесте: английский в MR, вопрос вместо утверждения при неполном контексте. Эти правила действуют для каждого сценария, который пишет в MR." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Сбор"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 3. Скрипт сбора collect/gitlab-mr" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Шаг скрипта" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="320" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Результат" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="50" width="240" height="26" as="geometry"/></mxCell><mxCell id="c5" value="Зачем он нужен" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="50" width="410" height="26" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1. Разобрать ссылку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="320" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2. Прочитать MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="138" width="320" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;mr&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="138" width="240" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;заголовок входа: автор, ветки, коммит&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="138" width="410" height="44" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;3. Сравнить с прошлым ревью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="194" width="320" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;has_new_commits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="194" width="240" height="44" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;условие запуска&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="194" width="410" height="44" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;4. Получить файлы и дифф с пределом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="320" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;files, diff&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="240" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;основной материал ревью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="410" height="44" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;5. Найти ключ тикета по ветке или заголовку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="306" width="320" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;ticket&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="306" width="240" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;только ключ: тикет скрипт не читает&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="306" width="410" height="44" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;6. Прочитать открытые треды&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="362" width="320" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;threads&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="362" width="240" height="44" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;не повторять уже сказанное&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="362" width="410" height="44" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;7. Найти строки архива ловушек по путям&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="418" width="320" height="44" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;memory_hits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="418" width="240" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;известные ловушки этих мест&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="418" width="410" height="44" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;8. Подготовить рабочую копию на коммите MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="320" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;worktree&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="474" width="240" height="44" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;читать код вокруг диффа локально&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="474" width="410" height="44" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;9. Отметить признаки риска&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="320" height="44" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;risk_flags&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="530" width="240" height="44" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;предложить человеку глубокое ревью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="410" height="44" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="Скрипт работает без модели и только на чтение. Большой дифф не идёт во вход целиком: модель получает список файлов и читает нужное из рабочей копии.&lt;br&gt;Признаки риска: миграции базы, платежи, безопасность, большой размер. Скрипт только отмечает их. Решение о глубоком ревью принимает человек." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1070" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Исполнение и проверка"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 4. Исполнение, сверка цитат и показ оператору" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Вход задачи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;пакет сбора и правила тона&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Ревью&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;средняя модель, рабочая копия&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Находки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;в фиксированном формате&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="190" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Сверка&lt;br&gt;цитат&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="180" height="84" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Черновики&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;английский, тон по правилам&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="170" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="FAIL: исправить или снять находку, до двух возвратов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="60"/><mxPoint x="365" y="60"/></Array></mxGeometry></mxCell><mxCell id="c13" value='&lt;b&gt;Формат находки&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;важность: blocking, should-fix, note&lt;br&gt;уверенность: confirmed, likely, question&lt;br&gt;файл и строка&lt;br&gt;цитата из кода&lt;br&gt;что не так и предложение&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="340" height="170" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Что проверяет сверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;файл есть в MR&lt;br&gt;строка в пределах окна&lt;br&gt;цитата совпадает с кодом&lt;br&gt;находок не больше десяти&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="220" width="340" height="170" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;Чего сверка не проверяет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;верна ли находка по существу&lt;br&gt;полон ли список находок&lt;br&gt;поэтому метка итога: «проверена форма»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="350" height="170" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Что видит оператор&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;список находок: важность, уверенность, файл и строка; цитаты сверил код&lt;br&gt;признаки риска из сбора и предложение запустить глубокое ревью&lt;br&gt;оператор называет находки; первая запись спрашивает один раз на задачу&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1090" height="120" as="geometry"/></mxCell><mxCell id="c17" value="Уровень уверенности следует из вида доказательства, а не из самооценки модели: решение D-2026-11-05. Вывод без полного контекста оформляется вопросом: решение D-2026-10-13." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1090" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Публикация"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 5. Публикация после одной кнопки" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Кнопка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;«Опубликовать»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Конверт открыт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;новые треды в этом MR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Публикация&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;до десяти тредов&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Конверт закрыт&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Запись&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;журнал; ловушка в память&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Задача закрыта&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="965" y="90" width="165" height="64" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Разрешено после кнопки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="520" height="250" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Создать новый тред в этом MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="480" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Не больше десяти тредов за задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="314" width="480" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Текст находок: указание модели, код не сверяет&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="480" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Остаётся под вопросом или запретом&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="530" height="320" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Approve и merge этого MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="490" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Ответы в чужих тредах и их закрытие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="314" width="490" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Push в ветку MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="378" width="490" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Комментарии в Jira и сообщения в Slack&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="442" width="490" height="50" as="geometry"/></mxCell><mxCell id="c23" value="Состояние ревью не хранится. Новая работа это push после последней заметки оператора в MR: так решает скрипт сбора.&lt;br&gt;Сообщения от имени оператора остаются в классе «только человек». Одно утверждение на задачу это и есть его решение." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="520" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Измерение"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 6. Что измеряем, чтобы понять, сработал ли сценарий" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Что измеряем" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="320" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Из каких событий" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="55" width="340" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Зачем" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="55" width="390" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Расход на одно ревью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="320" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;расход&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="95" width="340" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;сравнить с ревью без манифеста&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="390" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Доля запусков без модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="157" width="320" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;задача пропущена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="157" width="340" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;сколько повторных запросов были лишними&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="157" width="390" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Возвраты после сверки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="320" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;задача возвращена&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="219" width="340" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;как часто модель цитирует неточно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="219" width="390" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Доля опубликованных находок&lt;br&gt;(пока не считается)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="320" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;решение человека&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="281" width="340" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;полезны ли находки оператору&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="281" width="390" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Доля находок, принятых автором MR&lt;br&gt;(пока не считается)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="320" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;состояние тредов при следующем сборе&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="343" width="340" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;верны ли находки по существу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="343" width="390" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Подъёмы до сильной модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="320" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;уровень модели поднят&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="405" width="340" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;хватает ли среднего уровня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="740" y="405" width="390" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Базовая линия: 35 сессий ревью из 60 за 3–10 ноября, каждая в отдельной сессии. Расход этих сессий не измерен.&lt;br&gt;Первые две недели сценарий работает рядом со старым способом, чтобы было с чем сравнить.&lt;br&gt;Пятая строка закрывает слабость метки «проверена форма»: правильность находки видна по тому, принял ли её автор. Это запаздывающий сигнал, но он настоящий." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1090" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Что построить"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ревью MR · 7. Что есть и чего нет для этого сценария" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Формат находки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="420" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;есть: манифест и описание сценария в личном пакете&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="600" height="46" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Сверка цитат&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="128" width="420" height="46" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;есть в ядре&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="128" width="600" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Правила тона и языка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="186" width="420" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;есть в личном пакете: pack.md&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="186" width="600" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Скрипт сбора collect/gitlab-mr&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="244" width="420" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;есть&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="244" width="600" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Состояние ревью по MR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="420" height="46" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;не хранится: условие это push после заметки оператора&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="302" width="600" height="46" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Манифест mr-review&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="420" height="46" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;есть&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="600" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Исполнитель манифеста в ядре&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="418" width="420" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;есть&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="418" width="600" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Конверт с одним утверждением на задачу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="476" width="420" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;есть&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="476" width="600" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Событие «назначен ревьюером»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="534" width="420" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;нет, позже&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="534" width="600" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Что осталось&lt;/b&gt;&lt;br&gt;1. Публикация в настоящий MR в живом клиенте: не пройдена.&lt;br&gt;2. Событие «назначен ревьюером»: позже, отдельным манифестом.&lt;br&gt;Страница показывает состояние на 13.11.2026." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1060" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
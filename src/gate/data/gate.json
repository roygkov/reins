{
  "markers": ["prod", "production", "prd", "live"],
  "protected_branches": ["main", "master", "develop", "release/*", "release-*", "prod*", "production"],
  "prod_hosts": ["api.cloudflare.com", "*.myshopify.com", "api.heroku.com", "api.vercel.com", "api.netlify.com", "api.digitalocean.com"],
  "prod_scripts": ["*prod*", "*production*", "release*", "publish*", "deploy"],
  "prod_fastlane_lanes": ["release", "deploy", "beta", "production", "prod", "appstore", "playstore", "store"],
  "exempt_flags": ["--dry-run", "--dryrun", "--dry_run", "--check", "--diff", "--plan", "--validate", "--what-if", "--server-side-dry-run"],
  "rules": [
    {"id": "deploy.wrangler", "class": "prod-default", "cmd": ["wrangler"], "sub": [["deploy"], ["publish"], ["delete"], ["rollback"], ["versions", "deploy"], ["secret", "put"], ["secret", "delete"]]},
    {"id": "deploy.vercel", "class": "prod-default", "cmd": ["vercel"], "flags": ["--prod"]},
    {"id": "deploy.vercel-promote", "class": "prod-default", "cmd": ["vercel"], "sub": [["promote"], ["rollback"], ["remove"], ["rm"]]},
    {"id": "deploy.netlify", "class": "prod-default", "cmd": ["netlify"], "sub": [["deploy"]], "flags": ["--prod", "--prodIfUnlocked"]},
    {"id": "deploy.firebase", "class": "prod-default", "cmd": ["firebase"], "sub": [["deploy"], ["hosting:channel:deploy"], ["database:remove"], ["firestore:delete"]]},
    {"id": "deploy.fly", "class": "prod-default", "cmd": ["fly", "flyctl"], "sub": [["deploy"], ["apps", "destroy"], ["destroy"], ["secrets", "set"], ["scale", "count"]]},
    {"id": "deploy.heroku", "class": "prod-default", "cmd": ["heroku"], "sub": [["releases:rollback"], ["apps:destroy"], ["pg:reset"], ["config:set"], ["config:unset"]]},
    {"id": "deploy.eas", "class": "prod-default", "cmd": ["eas"], "sub": [["submit"], ["update"]]},
    {"id": "deploy.serverless", "class": "prod-default", "cmd": ["serverless", "sls"], "sub": [["deploy"], ["remove"]], "requires_prod": true},
    {"id": "release.gh", "class": "prod-default", "cmd": ["gh"], "sub": [["release", "create"], ["release", "delete"], ["release", "edit"], ["repo", "archive"], ["repo", "edit"]], "sub_anywhere": true},
    {"id": "hosting.repo-delete", "class": "protected", "cmd": ["gh", "glab"], "sub": [["repo", "delete"]], "sub_anywhere": true, "why": "deletes a repository on the hosting"},
    {"id": "release.glab", "class": "prod-default", "cmd": ["glab"], "sub": [["release", "create"], ["release", "delete"], ["repo", "archive"], ["repo", "transfer"]], "sub_anywhere": true},
    {"id": "publish.cargo", "class": "publish", "cmd": ["cargo"], "sub": [["publish"], ["yank"], ["owner"]]},
    {"id": "publish.npm", "class": "publish", "cmd": ["npm", "pnpm", "bun"], "sub": [["publish"], ["unpublish"], ["deprecate"], ["dist-tag", "add"], ["dist-tag", "rm"]]},
    {"id": "publish.yarn", "class": "publish", "cmd": ["yarn"], "sub": [["publish"], ["npm", "publish"]]},
    {"id": "publish.twine", "class": "publish", "cmd": ["twine"], "sub": [["upload"]]},
    {"id": "publish.python", "class": "publish", "cmd": ["poetry", "uv", "hatch", "flit", "pdm"], "sub": [["publish"]]},
    {"id": "publish.gem", "class": "publish", "cmd": ["gem"], "sub": [["push"], ["yank"]]},
    {"id": "publish.nuget", "class": "publish", "cmd": ["dotnet"], "sub": [["nuget", "push"], ["nuget", "delete"]]},
    {"id": "publish.mvn", "class": "publish", "cmd": ["mvn", "mvnw", "./mvnw"], "sub": [["deploy"], ["release:perform"]]},
    {"id": "publish.gradle", "class": "publish", "cmd": ["gradle", "gradlew", "./gradlew"], "task_contains": ["publish"], "task_exclude": ["publishToMavenLocal"]},
    {"id": "publish.pod", "class": "publish", "cmd": ["pod"], "sub": [["trunk", "push"], ["trunk", "delete"]]},
    {"id": "publish.apple", "class": "publish", "cmd": ["xcrun"], "sub": [["altool"], ["notarytool", "submit"]], "flags_any_for": {"altool": ["--upload-app", "--upload-package"]}},
    {"id": "infra.kubectl", "class": "infra", "cmd": ["kubectl", "oc"], "sub": [["delete"], ["apply"], ["replace"], ["patch"], ["scale"], ["drain"], ["cordon"], ["uncordon"], ["taint"], ["edit"], ["set"], ["rollout", "restart"], ["rollout", "undo"], ["create"], ["label"], ["annotate"], ["exec"]], "requires_prod": true, "context": "kube"},
    {"id": "infra.helm", "class": "infra", "cmd": ["helm"], "sub": [["install"], ["upgrade"], ["rollback"], ["uninstall"], ["delete"]], "requires_prod": true, "context": "kube"},
    {"id": "infra.terraform-destroy", "class": "infra", "cmd": ["terraform", "tofu", "terragrunt"], "sub": [["destroy"], ["run-all", "destroy"]]},
    {"id": "infra.terraform", "class": "infra", "cmd": ["terraform", "tofu"], "sub": [["apply"], ["import"], ["state", "rm"], ["state", "mv"], ["state", "push"], ["taint"], ["force-unlock"], ["workspace", "delete"]], "requires_prod": true, "context": "terraform"},
    {"id": "infra.terraform-auto", "class": "infra", "cmd": ["terraform", "tofu", "terragrunt"], "flags": ["-auto-approve", "--auto-approve"], "requires_prod": true, "context": "terraform"},
    {"id": "infra.terragrunt", "class": "infra", "cmd": ["terragrunt"], "sub": [["apply"], ["destroy"], ["run-all", "apply"], ["run-all", "destroy"], ["run", "--all"]], "requires_prod": true, "context": "terraform"},
    {"id": "infra.pulumi", "class": "infra", "cmd": ["pulumi"], "sub": [["up"], ["destroy"], ["refresh"], ["stack", "rm"], ["import"]], "requires_prod": true},
    {"id": "infra.cdk", "class": "infra", "cmd": ["cdk"], "sub": [["deploy"], ["destroy"]], "requires_prod": true, "context": "aws"},
    {"id": "infra.aws", "class": "infra", "cmd": ["aws"], "verb_prefix": ["delete", "terminate", "put", "remove", "update", "create", "deregister", "detach", "disable", "stop", "reboot", "purge", "rb", "rm"], "requires_prod": true, "context": "aws"},
    {"id": "infra.aws-s3", "class": "infra", "cmd": ["aws"], "sub": [["s3", "rm"], ["s3", "rb"], ["s3", "mv"]], "requires_prod": true, "context": "aws"},
    {"id": "infra.aws-s3-sync", "class": "infra", "cmd": ["aws"], "sub": [["s3", "sync"]], "flags": ["--delete"], "requires_prod": true, "context": "aws"},
    {"id": "infra.gcloud", "class": "infra", "cmd": ["gcloud"], "verb_prefix": ["delete", "deploy", "update", "create", "remove", "set-iam-policy", "add-iam-policy-binding", "stop", "reset", "resize"], "requires_prod": true, "context": "gcloud"},
    {"id": "infra.az", "class": "infra", "cmd": ["az"], "verb_prefix": ["delete", "purge", "create", "update", "set", "restart", "stop", "deallocate", "swap"], "requires_prod": true, "context": "az"},
    {"id": "infra.doctl", "class": "infra", "cmd": ["doctl"], "verb_prefix": ["delete", "create", "update", "resize", "power-off"], "requires_prod": true},
    {"id": "infra.ansible", "class": "infra", "cmd": ["ansible-playbook", "ansible"], "requires_prod": true},
    {"id": "infra.flux", "class": "infra", "cmd": ["flux"], "sub": [["reconcile"], ["suspend"], ["resume"], ["delete"], ["create"], ["uninstall"], ["bootstrap"]], "requires_prod": true, "context": "kube"},
    {"id": "infra.argocd", "class": "infra", "cmd": ["argocd"], "sub": [["app", "sync"], ["app", "delete"], ["app", "rollback"]], "requires_prod": true},
    {"id": "infra.image-push", "class": "infra", "cmd": ["docker", "podman", "nerdctl"], "sub": [["push"], ["image", "push"]], "requires_prod": true},
    {"id": "data.dbt", "class": "data", "cmd": ["dbt"], "sub": [["run"], ["build"], ["seed"], ["snapshot"], ["run-operation"]], "requires_prod": true, "context": "dbt"},
    {"id": "data.liquibase", "class": "data", "cmd": ["liquibase"], "sub": [["update"], ["update-count"], ["update-to-tag"], ["update-testing-rollback"], ["updateCount"], ["updateToTag"], ["updateTestingRollback"], ["rollback"], ["rollback-count"], ["rollback-to-date"], ["rollback-one-changeset"], ["rollback-one-update"], ["rollbackCount"], ["rollbackToDate"], ["rollbackOneChangeset"], ["rollbackOneUpdate"], ["drop-all"], ["dropAll"], ["clear-checksums"], ["clearCheckSums"]], "requires_prod": true, "context": "liquibase"},
    {"id": "secrets.aws", "class": "secrets", "cmd": ["aws"], "sub": [["secretsmanager"], ["ssm", "put-parameter"], ["ssm", "delete-parameter"]], "verb_any": ["put-secret-value", "update-secret", "delete-secret", "create-secret", "put-parameter", "delete-parameter"], "requires_prod": true, "context": "aws"},
    {"id": "secrets.gcloud", "class": "secrets", "cmd": ["gcloud"], "sub": [["secrets"]], "verb_any": ["add", "create", "delete", "destroy", "disable"], "requires_prod": true, "context": "gcloud"},
    {"id": "secrets.vault", "class": "secrets", "cmd": ["vault"], "sub": [["kv", "put"], ["kv", "delete"], ["kv", "destroy"], ["kv", "patch"], ["write"], ["delete"]], "requires_prod": true},
    {"id": "secrets.infisical", "class": "secrets", "cmd": ["infisical"], "sub": [["secrets", "set"], ["secrets", "delete"]], "requires_prod": true},
    {"id": "secrets.doppler", "class": "secrets", "cmd": ["doppler"], "sub": [["secrets", "set"], ["secrets", "delete"], ["secrets", "upload"]], "requires_prod": true},
    {"id": "secrets.ansible-vault", "class": "secrets", "cmd": ["ansible-vault"], "sub": [["edit"], ["encrypt"], ["create"], ["rekey"]], "requires_prod": true}
  ]
}

[
 {"name": "a read tool of the client passes", "tool": "read_file", "input": {"path": "src/a.ts"}, "expect": {"outcome": "allow", "rule": "default.read"}},
 {"name": "a change inside the work tree passes", "tool": "write_file", "input": {"path": "$CWD/src/a.ts"}, "expect": {"outcome": "allow", "rule": "default.local"}},
 {"name": "a relative path is read from the directory of the call", "tool": "write_file", "input": {"path": "src/a.ts"}, "expect": {"outcome": "allow", "rule": "default.local"}},
 {"name": "a write into the state of the harness is refused", "tool": "write_file", "input": {"path": "$STATE/tasks/t000000000000.json"}, "expect": {"outcome": "deny", "rule": "protect.state"}},
 {"name": "a write into the state through a path with dots is refused", "tool": "write_file", "input": {"path": "$CWD/../state/journal.jsonl"}, "expect": {"outcome": "deny", "rule": "protect.state"}},
 {"name": "a write into a pack asks the human", "tool": "write_file", "input": {"path": "$PACKS/person/pack.json"}, "expect": {"outcome": "ask", "rule": "protect.packs"}},
 {"name": "a file tool without its path counts as unknown", "tool": "write_file", "input": {"text": "x"}, "expect": {"outcome": "ask", "rule": "default.unknown-tool"}},
 {"name": "a tool that nothing describes counts as a write", "tool": "launch_rocket", "input": {}, "expect": {"outcome": "ask", "rule": "default.unknown-tool"}},
 {"name": "a read tool of a connector passes", "tool": "tracker__get_change", "input": {"change": "7"}, "expect": {"outcome": "allow", "rule": "default.read"}},
 {"name": "a write tool of a connector asks when no task names it", "tool": "tracker__add_comment", "input": {"change": "7"}, "expect": {"outcome": "ask", "rule": "default.write", "envelope": "none"}},
 {"name": "a write that the task names asks once for the task", "task": true, "tool": "tracker__add_comment", "input": {"change": "7"}, "expect": {"outcome": "ask", "rule": "default.write", "envelope": "confirm", "scope": "task", "task": true}},
 {"name": "after the approval of the human the named write passes", "task": true, "approved": [{"tool": "tracker__add_comment", "input": {"change": "7"}}], "tool": "tracker__add_comment", "input": {"change": "7"}, "expect": {"outcome": "allow", "envelope": "applied", "task": true}},
 {"name": "a number in the input fills the target as text", "task": true, "approved": [{"tool": "tracker__add_comment", "input": {"change": 7}}], "tool": "tracker__add_comment", "input": {"change": 7}, "expect": {"outcome": "allow", "envelope": "applied", "task": true}},
 {"name": "the approval of one target does not cover another target", "task": true, "approved": [{"tool": "tracker__add_comment", "input": {"change": "7"}}], "tool": "tracker__add_comment", "input": {"change": "8"}, "expect": {"outcome": "ask", "rule": "default.write", "envelope": "none"}},
 {"name": "the longest name pattern wins", "tool": "tracker__get_everything", "input": {}, "expect": {"outcome": "allow", "rule": "default.read"}},
 {"name": "a write whose target cannot be filled counts as unknown", "tool": "tracker__purge", "input": {}, "expect": {"outcome": "ask", "rule": "default.unknown-tool"}},
 {"name": "a target value with a line break counts as unknown", "tool": "tracker__add_comment", "input": {"change": "7\nx"}, "expect": {"outcome": "ask", "rule": "default.unknown-tool"}},
 {"name": "a write in a production environment asks for each action", "task": true, "tool": "live__add_comment", "input": {"change": "7"}, "expect": {"outcome": "ask", "rule": "default.write"}},
 {"name": "a plain shell command passes", "tool": "shell", "input": {"command": "ls -la"}, "expect": {"outcome": "allow", "rule": "default.shell"}},
 {"name": "a dangerous shell command follows the gate", "tool": "shell", "input": {"command": "git push --force origin main"}, "expect": {"outcome": "ask", "layer": "core", "gate": true}},
 {"name": "a shell command that names the state of the harness asks", "tool": "shell", "input": {"command": "echo x >> $STATE/journal.jsonl"}, "expect": {"outcome": "ask", "rule": "protect.state"}},
 {"name": "a shell tool without a command counts as unknown", "tool": "shell", "input": {"command": 7}, "expect": {"outcome": "ask", "rule": "default.unknown-tool"}}
